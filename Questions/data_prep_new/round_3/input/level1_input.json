א\u0005�\u0005׳\u0005ױ\u0005:\u0000\n\u0000׳\u0005ׁ\u0005ט\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000 \u0000\n\u0000ג\u0005א\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ח\u0005ױ\u0005 \u0000\u0013 \u0000�\u0005\"\u0000�\u0005 \u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005\n\u0000\n\u0000\n\u0000�\u0005ױ\u0005ײ\u0005�\u0005א\u0005�\u0005�\u0005:\u0000 \u0000\n\u0000ג\u0005ט\u0005�\u0005 \u0000׃\u0005.\u0000\u0007\u0000\u0013 \u0007\u0000�\u0005ױ\u0005ג\u0005�\u0005\"\u0000י\u0005 \u0000�\u0005י\u0005\"\u0000׀\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000ט\u0005װ\u0005\"\u0000�\u0005 \u0000ך\u0005�\u0005-\u0000׀\u0005ׁ\u0005�\u0005ׁ\u0005\u0007\u0000\u0007\u0000׀\u0005�\u0005�\u0005�\u0005 \u0000ׂ\u0005.\u0000\u0007\u0000\u0013 \u0007\u0000�\u0005ך\u0005�\u0005׳\u0005װ\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000ט\u0005װ\u0005\"\u0000�\u0005 \u0000ך\u0005�\u0005-\u0000׀\u0005ׁ\u0005�\u0005ׁ\u0005\u0007\u0000\u0007\u0000י\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005�\u0005\u0007\u0000\u0013 \u0007\u0000װ\u0005�\u0005�\u0005ױ\u0005א\u0005װ\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005׳\u0005ב\u0005�\u0005 \u0000ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005װ\u0005ך\u0005ג\u0005י\u0005�\u0005�\u0005װ\u0005\u0007\u0000\u0007\u0000\n\u0000\n\u0000�\u0005�\u0005ג\u0005ױ\u0005ו\u0005 \u0000�\u0005י\u0005ה\u0005״\u0005�\u0005:\u0000 \u0000\n\u0000ג\u0005�\u0005׃\u0005ױ\u0005 \u0000ׁ\u0005�\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005\n\u0000װ\u0005׃\u0005ט\u0005 \u0000ׁ\u0005ט\u0005-\u0000י\u0005�\u0005ױ\u0005�\u0005 \u0000(\u0000�\u0005ך\u0005�\u0005׳\u0005װ\u0005)\u0000\n\u0000\n\u0000�\u0005א\u0005װ\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000\n\u0000י\u0005�\u0005ױ\u0005׀\u0005�\u0005 \u0000�\u0005״\u0005ח\u0005ױ\u0005\n\u0000\n\u0000ט\u0005�\u0005ײ\u0005ך\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000\n\u0000׃\u0005א\u0005װ\u0005 \u0000ׁ\u0005ט\u0005ח\u0005\n\u0000\n\u0000ט\u0005�\u0005י\u0005ױ\u0005�\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005:\u0000\n\u0000װ\u0005׃\u0005ט\u0005 \u0000׀\u0005ׁ\u0005�\u0005ׁ\u0005\n\u0000 \u0000ז\u0005ױ\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005 \u0000(\u0000װ\u0005׀\u0005ט\u0005�\u0005ך\u0005 \u0000ך\u0005׳\u0005ױ\u0005�\u0005ך\u0005ױ\u0005 \u0000י\u0005�\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000ג\u0005ױ\u0005ׁ\u0005׃\u0005�\u0005�\u0005 \u0000�\u0005ב\u0005ױ\u0005�\u0005�\u0005�\u0005�\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ג\u0005\"\u0000ױ\u0005-\u0000 \u00002\u00000\u00001\u00005\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ג\u0005א\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ח\u0005ױ\u0005:\u0000\n\u0000\n\u0000ׁ\u0005ױ\u0005ח\u0005ט\u0005 \u0000״\u0005ױ\u0005ׁ\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005�\u0005.\u0000 \u0000װ\u0005�\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000׃\u0005�\u0005ױ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005װ\u0005ך\u0005א\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005׳\u0005�\u0005ט\u0005ױ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000א\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000א\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005�\u0005ג\u0005ׁ\u0005ט\u0005 \u0000׳\u0005׃\u0005 \u0000�\u0005ז\u0005ױ\u0005 \u0000י\u0005ג\u0005א\u0005�\u0005�\u0005א\u0005ױ\u0005 \u0000׀\u0005�\u0005ב\u0005ױ\u0005ט\u0005 \u0000װ\u0005ך\u0005׀\u0005ט\u0005ׂ\u0005א\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ב\u0005׃\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005ך\u0005 \u0000�\u0005י\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005 \u0000�\u0005�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005װ\u0005ך\u0005׳\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000\n\u0000\n\u0000י\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005�\u0005:\u0000\n\u0000\n\u0000ײ\u0005ױ\u0005 \u0000ט\u0005ױ\u0005״\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005�\u0005 \u0000י\u0005א\u0005װ\u0005,\u0000 \u0000י\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005װ\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005,\u0000 \u0000װ\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005ױ\u0005ב\u0005׃\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000ב\u0005ה\u0005ז\u0005�\u0005ה\u0005�\u0005,\u0000 \u0000�\u0005ג\u0005ױ\u0005�\u0005ך\u0005 \u0000װ\u0005י\u0005ׁ\u0005\"\u0000�\u0005,\u0000 \u0000װ\u0005�\u0005י\u0005״\u0005ט\u0005װ\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005ױ\u0005ז\u0005׀\u0005 \u0000ׁ\u0005׀\u0005�\u0005װ\u0005.\u0000 \u0000ׁ\u0005׀\u0005ױ\u0005ה\u0005�\u0005 \u0000�\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005 \u0000א\u0005ױ\u0005ך\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005ױ\u0005ה\u0005י\u0005 \u0000�\u0005װ\u0005ך\u0005׀\u0005ׂ\u0005׃\u0005,\u0000 \u0000�\u0005װ\u0005ך\u0005׀\u0005ט\u0005ׂ\u0005�\u0005,\u0000 \u0000ײ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005א\u0005�\u0005ב\u0005װ\u0005 \u0000�\u0005׀\u0005ט\u0005ׂ\u0005ױ\u0005א\u0005�\u0005 \u0000ג\u0005ױ\u0005ׁ\u0005׃\u0005�\u0005�\u0005 \u0000�\u0005�\u0005ח\u0005ױ\u0005�\u0005ױ\u0005ך\u0005 \u0000ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005ױ\u0005ז\u0005׀\u0005 \u0000ׁ\u0005ײ\u0005װ\u0005.\u0000 \u0000ױ\u0005װ\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005�\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005,\u0000 \u0000�\u0005י\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ך\u0005 \u0000�\u0005ג\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005,\u0000 \u0000י\u0005�\u0005ה\u0005�\u0005װ\u0005 \u0000א\u0005ױ\u0005ך\u0005א\u0005�\u0005�\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005ױ\u0005ז\u0005�\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ך\u0005׳\u0005ױ\u0005�\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000ג\u0005ױ\u0005ׁ\u0005׃\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005ב\u0005׃\u0005,\u0000 \u0000�\u0005װ\u0005�\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005ױ\u0005ה\u0005י\u0005 \u0000�\u0005װ\u0005ך\u0005׀\u0005ט\u0005ׂ\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005ױ\u0005ז\u0005׀\u0005 \u0000ׁ\u0005׀\u0005�\u0005װ\u0005.\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ג\u0005א\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ח\u0005ױ\u0005:\u0000\n\u0000\n\u0000ײ\u0005װ\u0005 \u0000׳\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000ז\u0005װ\u0005\"\u0000�\u0005?\u0000\n\u0000\n\u0000י\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005�\u0005:\u0000\n\u0000\n\u0000ז\u0005װ\u0005\"\u0000�\u0005 \u0000ײ\u0005װ\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ב\u0005ױ\u0005׃\u0005:\u0000 \u0000װ\u0005ז\u0005ׁ\u0005׀\u0005.\u0000\n\u0000\n\u0000�\u0005�\u0005 \u0000׀\u0005ט\u0005ׂ\u0005ױ\u0005�\u0005 \u0000ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005א\u0005�\u0005 \u0000י\u0005�\u0005י\u0005 \u0000�\u0005ױ\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000ב\u0005ה\u0005ז\u0005�\u0005ה\u0005�\u0005,\u0000 \u0000װ\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005ה\u0005ז\u0005�\u0005ה\u0005�\u0005 \u0000�\u0005ך\u0005�\u0005�\u0005׳\u0005ב\u0005 \u0000�\u0005ײ\u0005װ\u0005.\u0000 \u0000װ\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005�\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000ב\u0005ה\u0005ז\u0005�\u0005ה\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005ב\u0005׃\u0005,\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000׀\u0005�\u0005ױ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005,\u0000 \u0000�\u0005ה\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005�\u0005 \u0000י\u0005א\u0005װ\u0005 \u0000�\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000װ\u0005׳\u0005ױ\u0005ו\u0005 \u0000ױ\u0005װ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005 \u0000ױ\u0005�\u0005װ\u0005׀\u0005ט\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ז\u0005ױ\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000ׁ\u0005י\u0005א\u0005װ\u0005.\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ג\u0005א\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ח\u0005ױ\u0005:\u0000\n\u0000\n\u0000�\u0005�\u0005װ\u0005 \u0000ׁ\u0005ג\u0005ז\u0005�\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000ה\u0005ט\u0005�\u0005א\u0005א\u0005״\u0005�\u0005?\u0000 \u0000�\u0005װ\u0005ה\u0005ױ\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u0000װ\u0005ײ\u0005׀\u0005ך\u0005 \u0000י\u0005�\u0005�\u0005 \u0000י\u0005א\u0005װ\u0005 \u0000׀\u0005ך\u0005�\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005.\u0000\n\u0000\n\u0000י\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005�\u0005:\u0000\n\u0000\n\u0000ײ\u0005װ\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ױ\u0005ב\u0005׃\u0005.\u0000 \u0000א\u0005׃\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005 \u0000י\u0005ג\u0005ױ\u0005ׁ\u0005׃\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000ײ\u0005װ\u0005.\u0000\n\u0000\n\u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005׀\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000�\u0005ג\u0005י\u0005ױ\u0005ך\u0005 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ך\u0005 \u0000י\u0005ג\u0005װ\u0005,\u0000 \u0000�\u0005װ\u0005׀\u0005ט\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005�\u0005 \u0000׳\u0005�\u0005י\u0005 \u0000י\u0005א\u0005�\u0005�\u0005,\u0000 \u0000�\u0005�\u0005 \u0000ז\u0005ױ\u0005ה\u0005�\u0005�\u0005 \u0000ה\u0005א\u0005�\u0005 \u0000ג\u0005ך\u0005�\u0005׃\u0005 \u0000ױ\u0005ט\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000י\u0005�\u0005א\u0005ט\u0005׀\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ױ\u0005ב\u0005׃\u0005,\u0000 \u0000ױ\u0005׀\u0005ײ\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000ג\u0005ז\u0005�\u0005ױ\u0005.\u0000\n\u0000\n\u0000ג\u0005�\u0005׃\u0005ױ\u0005 \u0000ׁ\u0005�\u0005 \u0000�\u0005ז\u0005׳\u0005ח\u0005:\u0000\n\u0000\n\u0000װ\u0005׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ב\u0005�\u0005�\u0005�\u0005 \u0000ג\u0005׃\u0005 \u0000י\u0005א\u0005װ\u0005.\u0000 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005׳\u0005�\u0005׃\u0005�\u0005 \u0000י\u0005׀\u0005ה\u0005י\u0005ט\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005ך\u0005ח\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005�\u0005ב\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000׃\u0005ױ\u0005ט\u0005י\u0005 \u0000װ\u0005ז\u0005ג\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005.\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ג\u0005א\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ח\u0005ױ\u0005:\u0000\n\u0000\n\u0000א\u0005ז\u0005�\u0005ׂ\u0005 \u0000װ\u0005�\u0005ױ\u0005ב\u0005׃\u0005,\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000\n\u0000\n\u0000ג\u0005ט\u0005�\u0005 \u0000׃\u0005.\u0000:\u0000\n\u0000\n\u0000ׁ\u0005ױ\u0005ח\u0005ט\u0005 \u0000״\u0005ױ\u0005ׁ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005׳\u0005ײ\u0005ױ\u0005ט\u0005 \u0000ג\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005�\u0005 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005.\u0000 \u0000׀\u0005�\u0005�\u0005 \u0000װ\u0005ׁ\u0005ג\u0005�\u0005װ\u0005 \u0000׀\u0005ױ\u0005 \u0000װ\u0005ג\u0005ױ\u0005ׁ\u0005׃\u0005װ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000י\u0005�\u0005�\u0005ױ\u0005ב\u0005׃\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005.\u0000 \u0000�\u0005י\u0005 \u0000׃\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005א\u0005ױ\u0005י\u0005׀\u0005,\u0000 \u0000�\u0005י\u0005 \u0000ג\u0005א\u0005�\u0005�\u0005א\u0005�\u0005�\u0005 \u0000�\u0005�\u0005׀\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005׀\u0005�\u0005 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000׳\u0005ח\u0005�\u0005ח\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ױ\u0005ב\u0005׃\u0005.\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000ׁ\u0005׀\u0005�\u0005�\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ױ\u0005ב\u0005׃\u0005,\u0000 \u0000׀\u0005�\u0005�\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005ג\u0005י\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005װ\u0005ױ\u0005ט\u0005׀\u0005װ\u0005 \u0000װ\u0005ב\u0005ה\u0005ז\u0005�\u0005ה\u0005�\u0005ך\u0005,\u0000 \u0000�\u0005�\u0005ױ\u0005 \u0000�\u0005�\u0005י\u0005�\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005י\u0005ׁ\u0005\"\u0000�\u0005,\u0000 \u0000י\u0005׀\u0005ױ\u0005ב\u0005ט\u0005ך\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005װ\u0005ך\u0005׀\u0005ט\u0005ׂ\u0005א\u0005ױ\u0005ך\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ג\u0005׃\u0005�\u0005�\u0005�\u0005 \u0000�\u0005י\u0005ך\u0005�\u0005י\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005װ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005׳\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ח\u0005�\u0005ׁ\u0005ױ\u0005ז\u0005�\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ך\u0005�\u0005ט\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005א\u0005ױ\u0005י\u0005׀\u0005 \u0000װ\u0005ײ\u0005װ\u0005.\u0000\n\u0000\n\u0000א\u0005׃\u0005ׁ\u0005ט\u0005א\u0005ױ\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000�\u0005�\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ו\u0005 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000י\u0005ך\u0005�\u0005 \u0000׀\u0005ה\u0005י\u0005ט\u0005ױ\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005ױ\u0005 \u0000ך\u0005�\u0005\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0018\b\u0000\u0000\u001a\b\u0000\u0000 \b\u0000\u0000,\b\u0000\u0000.\b\u0000\u00002\b\u0000\u00004\b\u0000\u0000N\b\u0000\u0000R\b\u0000\u0000T\b\u0000\u0000†\b\u0000\u0000ˆ\b\u0000\u0000ע\b\u0000\u0000פ\b\u0000\u0000צ\b\u0000\u0000ת\b\u0000\u0000\n \u0000\u0000 \u0000\u0000\u000e \u0000\u0000¢ \u0000\u0000₪ \u0000\u0000¦ \u0000\u0000¨ \u0000\u0000� \u0000\u0000־ \u0000\u0000׀ \u0000\u0000א \u0000\u0000ז \u0000\u0000מ \u0000\u0000ר \u0000\u0000ת \u0000\u0000� \u0000\u0000קךגק׳ְֽק¶ְקְ¬�–ֽ�‰ֽ�ֽ|t‰�ֽm�f�^S\u0000\u0000\u0015\u0016hץG \u00005\b�>*\u0001Z\b�\\\b�o(\u0002\u000f\u0015h‏\u0003D\u0000\u0016h\u0016Aז\u0000Z\b� \u0016h� K\u0000Z\b�o(\u0002\u0000 \u0016h‏\u0003D\u0000Z\b�o(\u0002\u0000\u000f\u0015h₪\u0013‡\u0000\u0016h‏\u0003D\u0000Z\b� \u0016h\u0016Aז\u0000Z\b�\u000f\u0015h‏\u0003D\u0000\u0016h‏\u0003D\u0000Z\b�\u0018\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u00005\b�>*\u0001Z\b�\\\b�\u0000\u000f\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u0000Z\b�\u001b\u0015h₪\u0013‡\u0000\u001