005�\u0005�\u0005 \u00002\u00000\u00000\u00008\u0000)\u0000,\u0000 \u0000י\u0005ג\u0005װ\u0005 \u00001\u00002\u0000:\u00000\u00000\u0000\n\u0000\n\u0000\n\u0000\n\u0000ב\u0005׃\u0005ט\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005:\u0000 \u0000 \u0000 \u0000\n\u0000װ\u0005ז\u0005ג\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000(\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ב\u0005'\u0000 \u00004\u00003\u0000)\u0000 \u0000(\u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005ׂ\u0005י\u0005ך\u0005 \u0000װ\u0005׃\u0005ױ\u0005׳\u0005 \u0000ױ\u0005װ\u0005א\u0005׳\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ב\u0005\"\u0000׳\u0005-\u00002\u00000\u00000\u00008\u0000 \u0000\u0013 \u0000װ\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005׀\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005י\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005\n\u0000\n\u0000א\u0005�\u0005׳\u0005ױ\u0005:\u0000\n\u0000׳\u0005ׁ\u0005ט\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000\n\u0000ײ\u0005ׁ\u0005ױ\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005ׁ\u0005 \u0000 \u0000 \u0000\u0013 \u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005\n\u0000\n\u0000\n\u0000\n\u0000\n\u0000�\u0005ױ\u0005ײ\u0005�\u0005א\u0005�\u0005�\u0005:\u0000\n\u0000�\u0005ג\u0005ח\u0005ׁ\u0005 \u0000ײ\u0005�\u0005ז\u0005ט\u0005 \u0000 \u0000-\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005�\u0005י\u0005�\u0005װ\u0005\n\u0000י\u0005ט\u0005�\u0005ך\u0005 \u0000י\u0005ה\u0005�\u0005ׂ\u0005�\u0005י\u0005״\u0005�\u0005�\u0005�\u0005 \u0000-\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005�\u0005\n\u0000ט\u0005�\u0005�\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005ו\u0005 \u0000 \u0000-\u0000 \u0000�\u0005ױ\u0005ג\u0005�\u0005\"\u0000י\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005\n\u0000א\u0005ױ\u0005ט\u0005�\u0005ך\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005�\u0005 \u0000 \u0000-\u0000 \u0000�\u0005ױ\u0005ג\u0005�\u0005\"\u0000י\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005\n\u0000\n\u0000\n\u0000\n\u0000 \u0000\n\u0000\n\u0000\n\u0000�\u0005א\u0005װ\u0005�\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000 \u0000 \u0000׳\u0005א\u0005װ\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005׃\u0005�\u0005�\u0005\n\u0000\n\u0000�\u0005ױ\u0005ג\u0005ו\u0005 \u0000�\u0005י\u0005ה\u0005״\u0005�\u0005:\u0000 \u0000 \u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000ח\u0005ט\u0005�\u0005\n\u0000\n\u0000\n\u0000ט\u0005י\u0005�\u0005װ\u0005 \u0000ױ\u0005ג\u0005ט\u0005�\u0005װ\u0005:\u0000 \u0000 \u0000ב\u0005�\u0005׃\u0005ט\u0005 \u0000�\u0005ׁ\u0005�\u0005׀\u0005 \u0000-\u0000 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005ך\u0005ט\u0005ׂ\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005ג\u0005\"\u0000�\u0005\n\u0000 \u0000\n\u0000װ\u0005ז\u0005ג\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000(\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ב\u0005'\u0000 \u00004\u00003\u0000)\u0000 \u0000(\u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005ׂ\u0005י\u0005ך\u0005 \u0000װ\u0005׃\u0005ױ\u0005׳\u0005 \u0000ױ\u0005װ\u0005א\u0005׳\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ב\u0005\"\u0000׳\u0005-\u00002\u00000\u00000\u00008\u0000 \u0000\u0013 \u0000װ\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005׀\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005י\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005\n\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ײ\u0005ׁ\u0005ױ\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005ׁ\u0005:\u0000\n\u0000\n\u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ה\u0005ױ\u0005ך\u0005׳\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005י\u0005�\u0005ׁ\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000י\u0005ך\u0005ױ\u0005ח\u0005׃\u0005י\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ב\u0005'\u0000 \u00004\u00003\u0000,\u0000 \u0000װ\u0005ז\u0005ג\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000(\u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005ׂ\u0005י\u0005ך\u0005 \u0000װ\u0005׃\u0005ױ\u0005׳\u0005 \u0000ױ\u0005װ\u0005א\u0005׳\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005)\u0000.\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ח\u0005�\u0005�\u0005�\u0005א\u0005ױ\u0005 \u0000�\u0005י\u0005�\u0005ׁ\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005ג\u0005ז\u0005ך\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005ך\u0005 \u0000ױ\u0005ג\u0005�\u0005 \u0000װ\u0005�\u0005י\u0005�\u0005װ\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005ך\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ױ\u0005װ\u0005ׂ\u0005ג\u0005א\u0005ױ\u0005 \u0000�\u0005װ\u0005ׁ\u0005א\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005׀\u0005י\u0005ט\u0005 \u0000�\u0005א\u0005ױ\u0005ב\u0005׳\u0005 \u0000י\u0005�\u0005ױ\u0005ׁ\u0005׀\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005׀\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005י\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005.\u0000 \u0000ײ\u0005װ\u0005 \u0000װ\u0005א\u0005ױ\u0005ב\u0005׳\u0005 \u0000װ\u0005�\u0005ׁ\u0005�\u0005 \u0000י\u0005�\u0005ױ\u0005א\u0005׳\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005א\u0005ױ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ז\u0005�\u0005ג\u0005 \u0000י\u0005ך\u0005ח\u0005ט\u0005׀\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005.\u0000 \u0000\n\u0000\n\u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000ח\u0005ט\u0005�\u0005:\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ח\u0005 \u0000׀\u0005ׂ\u0005�\u0005׃\u0005 \u0000ח\u0005ױ\u0005׃\u0005�\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000א\u0005ױ\u0005ב\u0005׳\u0005 \u0000י\u0005װ\u0005ױ\u0005ב\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000א\u0005ױ\u0005ב\u0005׳\u0005 \u0000י\u0005װ\u0005�\u0005 \u0000װ\u0005ג\u0005ׁ\u0005�\u0005ט\u0005ױ\u0005 \u0000׀\u0005�\u0005�\u0005א\u0005ױ\u0005.\u0000 \u0000ׁ\u0005י\u0005�\u0005׳\u0005װ\u0005 \u0000�\u0005ױ\u0005ח\u0005׃\u0005�\u0005ך\u0005 \u0000ה\u0005װ\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000װ\u0005�\u0005י\u0005�\u0005ׁ\u0005װ\u0005,\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005 \u0000װ\u0005י\u0005ׂ\u0005װ\u0005 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000װ\u0005ב\u0005ג\u0005�\u0005ה\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ײ\u0005ׁ\u0005ױ\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005ׁ\u0005:\u0000\n\u0000\n\u0000�\u0005י\u0005א\u0005ׂ\u0005�\u0005ג\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005,\u0000 \u0000ׁ\u0005ב\u0005׃\u0005ט\u0005 \u0000ׂ\u0005�\u0005ױ\u0005ט\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ט\u0005׀\u0005י\u0005 \u0000׳\u0005ױ\u0005י\u0005ד\u0005 \u0000׀\u0005ך\u0005 \u0000׳\u0005ױ\u0005�\u0005י\u0005ױ\u0005ך\u0005�\u0005�\u0005 \u0000�\u0005�\u0005ה\u0005�\u0005 \u0000ׁ\u0005ח\u0005י\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ױ\u0005׃\u0005װ\u0005 \u0000י\u0005�\u0005י\u0005 \u0000�\u0005�\u0005 \u0000׳\u0005ױ\u0005�\u0005י\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000ח\u0005ט\u0005�\u0005:\u0000\n\u0000\n\u0000ײ\u0005ױ\u0005 \u0000װ\u0005ז\u0005ג\u0005ך\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000(\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ב\u0005'\u0000 \u00004\u00003\u0000)\u0000 \u0000(\u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005ׂ\u0005י\u0005ך\u0005 \u0000װ\u0005׃\u0005ױ\u0005׳\u0005 \u0000ױ\u0005װ\u0005א\u0005׳\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ב\u0005\"\u0000׳\u0005-\u00002\u00000\u00000\u00008\u0000.\u0000 \u0000\n\u0000\n\u0000 \u00001\u0000)\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00004\u0000,\u0000 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005,\u0000 \u0000װ\u0005ך\u0005י\u0005�\u0005\"\u0000׳\u0005-\u00001\u00009\u00005\u00008\u0000,\u0000 \u0000א\u0005ױ\u0005ב\u0005׳\u0005 \u0000�\u0005י\u0005ױ\u0005�\u0005ׁ\u0005 \u0000(\u0000�\u0005װ\u0005�\u0005�\u0005:\u0000 \u0000װ\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005)\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00004\u0000 \u0000ׁ\u0005'\u0000.\u0000 \u00001\u0000.\u0000 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005ױ\u0005 \u0000�\u0005ב\u0005ױ\u0005�\u0005�\u0005 \u00001\u0000 \u0000ױ\u0005ׁ\u0005ה\u0005ב\u0005ח\u0005װ\u0005 \u00001\u0000,\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000א\u0005ה\u0005ט\u0005׃\u0005,\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000׀\u0005י\u0005ט\u0005 \u0000�\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ױ\u0005�\u0005ה\u0005ױ\u0005ט\u0005ב\u0005�\u0005'\u0000.\u0000 \u00002\u0000.\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000ה\u0005ב\u0005ח\u0005װ\u0005 \u00001\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000(\u00002\u0000)\u0000 \u0000ג\u0005�\u0005 \u0000׀\u0005ד\u0005 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005ה\u0005ב\u0005ח\u0005װ\u0005 \u00001\u0000 \u0000�\u0005�\u0005ז\u0005�\u0005׀\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000�\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000א\u0005ה\u0005ט\u0005׃\u0005,\u0000 \u0000�\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005װ\u0005 \u0000ה\u0005ב\u0005ח\u0005װ\u0005.\u0000 \u0000ׁ\u0005�\u0005�\u0005�\u0005 \u0000ה\u0005ׂ\u0005ט\u0005ך\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000�\u0005ה\u0005ױ\u0005ט\u0005ב\u0005�\u0005 \u0000װ\u0005׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000�\u0005�\u0005׃\u0005,\u0000 \u0000ׁ\u0005�\u0005ױ\u0005ג\u0005׃\u0005 \u0000י\u0005�\u0005ח\u0005ׁ\u0005ג\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000ױ\u0005�\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005׀\u0005ױ\u0005׳\u0005ט\u0005 \u0000�\u0005ך\u0005ױ\u0005�\u0005 \u0000װ\u0005י\u0005ׁ\u0005ױ\u0005ג\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005 \u0000װ\u0005ח\u0005ט\u0005ױ\u0005ׁ\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005.\u0000 \u0000\n\u0000\n\u00002\u0000)\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00006\u0000.\u0000 \u0000�\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00006\u0000(\u0000׀\u0005)\u0000(\u00002\u0000)\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005,\u0000 \u0000ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000ױ\u0005׀\u0005ױ\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000װ\u0005�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005�\u0005�\u0005�\u0005 \u0000ה\u0005ׂ\u0005ט\u0005ך\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000�\u0005ױ\u0005א\u0005׳\u0005 \u0000װ\u0005׃\u0005ױ\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ג\u0005׃\u0005 \u0000�\u0005׀\u0005ױ\u0005׳\u0005ט\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005׀\u0005ױ\u0005׳\u0005ט\u0005 \u0000�\u0005ך\u0005ױ\u0005�\u0005 \u0000װ\u0005י\u0005ׁ\u0005ױ\u0005ג\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005 \u0000װ\u0005ח\u0005ט\u0005ױ\u0005ׁ\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005'\u0000.\u0000\n\u0000\n\u00003\u0000)\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00000\u0000.\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00000\u0000(\u0000ױ\u0005)\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005 \u0000ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000ױ\u0005�\u0005׳\u0005ױ\u0005�\u0005ױ\u0005 \u0000�\u0005ג\u0005א\u0005�\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00006\u0000(\u0000׀\u0005)\u0000(\u00002\u0000)\u0000 \u0000ב\u0005�\u0005ה\u0005׀\u0005'\u0000.\u0000 \u0000\n\u0000\n\u0000�\u0005ב\u0005ג\u0005�\u0005ה\u0005�\u0005�\u0005 \u00004\u0000 \u0000ױ\u0005-\u00005\u0000 \u0000�\u0005ױ\u0005ז\u0005ג\u0005ױ\u0005ך\u0005 \u0000י\u0005ך\u0005�\u0005 \u0000ׂ\u0005ט\u0005ב\u0005׀\u0005ױ\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ח\u0005 \u0000׀\u0005ב\u0005ׁ\u0005�\u0005ט\u0005.\u0000 \u0000ׂ\u0005ט\u0005ב\u0005װ\u0005 \u0000׀\u0005'\u0000 \u0000׀\u0005ױ\u0005�\u0005ט\u0005ך\u0005 \u0000י\u0005ׂ\u0005�\u0005 \u0000׳\u0005ױ\u0005ױ\u0005ך\u0005 \u0000׃\u0005ג\u0005ך\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000ה\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00001\u0000,\u0000 \u0000ך\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005.\u0000 \u0000ׂ\u0005ט\u0005ב\u0005װ\u0005 \u0000ׁ\u0005'\u0000 \u0000�\u0005י\u0005׀\u0005�\u0005ט\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005�\u0005ז\u0005ׁ\u0005 \u0000�\u0005�\u0005ג\u0005י\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005 \u0000י\u0005װ\u0005ױ\u0005׀\u0005 \u0000ח\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005י\u0005׳\u0005ױ\u0005ױ\u0005ך\u0005 \u0000׃\u0005ג\u0005ך\u0005 \u0000�\u0005ױ\u0005ׂ\u0005י\u0005ך\u0005 \u0000�\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ײ\u0005ׁ\u0005ױ\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005ׁ\u0005:\u0000\n\u0000\n\u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000ט\u0005ז\u0005װ\u0005 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005ױ\u0005ך\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ך\u0005ױ\u0005�\u0005�\u0005 \u0000ׁ\u0005ׂ\u0005ט\u0005ב\u0005װ\u0005 \u0000׀\u0005'\u0000.\u0000 \u0000׀\u0005�\u0005�\u0005 \u0000ז\u0005ױ\u0005ט\u0005�\u0005 \u0000�\u0005װ\u0005ח\u0005ט\u0005�\u0005׀\u0005 \u0000׀\u0005ך\u0005 \u0000ׂ\u0005ט\u0005ב\u0005װ\u0005 \u0000ׁ\u0005'\u0000.\u0000 \u0000\n\u0000\n\u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000ח\u0005ט\u0005�\u0005:\u0000\n\u0000\n\u00004\u0000)\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00001\u0000.\u0000 \u0000�\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00001\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000'\u0000ך\u0005ה\u0005ױ\u0005ט\u0005ב\u0005�\u0005'\u0000,\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000ך\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ױ\u0005ך\u0005ה\u0005ױ\u0005ט\u0005ב\u0005�\u0005'\u0000.\u0000\n\u0000\n\u00005\u0000)\u0000 \u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00008\u0000.\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00008\u0000(\u0000׀\u0005)\u0000(\u00001\u0000)\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005.\u0000 \u00001\u0000.\u0000 \u0000ׁ\u0005ה\u0005ב\u0005ח\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000ׁ\u0005'\u0000,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000'\u0000�\u0005ה\u0005ט\u0005ב\u0005ױ\u0005�\u0005װ\u0005'\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000�\u0005װ\u0005א\u0005׳\u0005ך\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005'\u0000.\u0000 \u00002\u0000.\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000ה\u0005ב\u0005ח\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000ׁ\u0005'\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000(\u0000ׁ\u0005)\u0000(\u00001\u0000)\u0000 \u0000ג\u0005א\u0005�\u0005�\u0005�\u0005 \u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000א\u0005ה\u0005ט\u0005׃\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00004\u0000(\u0000ׁ\u0005)\u0000,\u0000 \u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005װ\u0005א\u0005׳\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005ױ\u0005ג\u0005׃\u0005 \u0000װ\u0005ה\u0005ט\u0005ב\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005ה\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00004\u0000(\u0000ׁ\u0005)\u0000(\u00002\u0000)\u0000,\u0000 \u0000�\u0005ה\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005ח\u0005׃\u0005�\u0005'\u0000.\u0000 \u0000\n\u00006\u0000)\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00004\u00006\u0000.\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00004\u00006\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005:\u0000 \u00001\u0000.\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u0000ח\u0005״\u0005�\u0005 \u0000(\u0000׀\u0005)\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000'\u0000�\u0005ׂ\u0005�\u0005י\u0005 \u0000�\u0005�\u0005א\u0005ב\u0005ך\u0005'\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000�\u0005�\u0005�\u0005�\u0005'\u0000,\u0000 \u0000ױ\u0005ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000�\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005'\u0000.\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u0000ח\u0005״\u0005�\u0005 \u0000(\u0000ׁ\u0005)\u0000 \u0000ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ױ\u0005�\u0005ױ\u0005א\u0005׳\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005'\u0000.\u0000 \u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ײ\u0005ׁ\u0005ױ\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005ׁ\u0005:\u0000\n\u0000\n\u0000�\u0005י\u0005 \u0000�\u0005�\u0005 \u0000װ\u0005ג\u0005ט\u0005װ\u0005.\u0000 \u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00004\u0000,\u0000 \u00001\u0000.\u0000 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u0000ח\u0005״\u0005�\u0005 \u0000(\u00002\u0000)\u0000,\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000ה\u0005ב\u0005ח\u0005װ\u0005 \u00001\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000'\u0000ג\u0005�\u0005 \u0000׀\u0005ד\u0005 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005ה\u0005ב\u0005ח\u0005װ\u0005 \u00001\u0000 \u0000�\u0005�\u0005ז\u0005�\u0005׀\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000�\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000׃\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005�\u0005.\u0000.\u0000.\u0000'\u0000.\u0000 \u0000ׁ\u0005ב\u0005׃\u0005ט\u0005,\u0000 \u0000ב\u0005�\u0005�\u0005׳\u0005װ\u0005.\u0000 \u0000׀\u0005�\u0005�\u0005 \u0000�\u0005�\u0005 \u0000װ\u0005ג\u0005ט\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000א\u0005ױ\u0005ט\u0005�\u0005ך\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005�\u0005:\u0000\n\u0000\n\u0000׀\u0005׃\u0005ױ\u0005א\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005,\u0000 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u00001\u0000,\u0000 \u0000װ\u0005�\u0005ױ\u0005�\u0005 \u0000װ\u0005א\u0005ױ\u0005ב\u0005׳\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000י\u0005׳\u0005ױ\u0005ױ\u0005ך\u0005 \u0000׃\u0005ג\u0005ך\u0005,\u0000 \u0000�\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u0000װ\u0005ײ\u0005װ\u0005,\u0000 \u0000ך\u0005ה\u0005ױ\u0005ט\u0005ב\u0005�\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ג\u0005׃\u0005 \u0000י\u0005�\u0005ח\u0005ׁ\u0005ג\u0005 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005.\u0000 \u0000ײ\u0005׀\u0005ך\u0005 \u0000׀\u0005ױ\u0005�\u0005ט\u0005ך\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000ה\u0005�\u0005 \u0000װ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000װ\u0005�\u0005ׁ\u0005ח\u0005ט\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005ׂ\u0005�\u0005ט\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005ױ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005׳\u0005 \u0000װ\u0005ײ\u0005�\u0005א\u0005�\u0005�\u0005.\u0000 \u0000ג\u0005�\u0005י\u0005�\u0005ױ\u0005 \u0000ט\u0005ױ\u0005ז\u0005�\u0005\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000|\b\u0000\u0000„\b\u0000\u0000־\b\u0000\u0000< \u0000\u0000> \u0000\u0000T \u0000\u0000\n\u0000\u0000\u000e\n\u0000\u0000B\n\u0000\u0000D\n\u0000\u0000N\n\u0000\u0000R\n\u0000\u0000h\n\u0000\u0000�\n\u0000\u0000�\n\u0000\u0000¢\n\u0000\u0000°\n\u0000\u0000� \u0000\u0000צ \u0000\u0000� \u0000\u0000\u0016 \u0000\u0000* \u0000\u0000, \u0000\u0000B \u0000\u0000Z \u0000\u0000` \u0000\u0000� \u0000\u0000� \u0000\u0000N\n\u0000\u0000P\n\u0000\u0000ˆ\n\u0000\u0000®\n\u0000\u0000\u0000\u0010\u0000\u0000\u0010\u0010\u0000\u0000 \u0011\u0000\u0000 \u0011\u0000\u0000B\u0011\u0000\u0000\u0010\u0012\u0000\u0000\u0012\u0012\u0000\u0000\"\u0012\u0000\u0000$\u0012\u0000\u0000&\u0012\u0000\u0000ר\u0019\u0000\u0000ת\u0019\u0000\u0000 \u001a\u0000\u0000¸\u001a\u0000\u0000÷\u001a\u0000\u0000�\u001a\u0000\u00002 \u0000\u0000V \u0000\u0000| \u0000\u0000~ \u0000\u0000– \u0000\u0000�!\u0000\u0000\u0000.\u0000\u0000’.\u0000\u0000”.\u0000\u0000¸.\u0000\u0000ז.\u0000\u0000ט.\u0000\u0000סוסױֹױֹ¿ֹסױסױֹ¿ֹױֹױסֹױסֹױסֹ¿ױ°ױ£ֹ£ֹ�£ֹ�£ֹ£ֹ�£ֹ�£ֹ£ֹ�£ֹ˜ֹ�£ֹ�\u0003U\b\u0001\u0010\u0015h}u×\u0000\u0016h}u×\u0000^J\u0003\u0000\u0000\u0019\u0015h}u×\u0000\u0016h}u×\u0000>*\u0001Z\b�^J\u0003\u0000o(\u0002 \u0015h}u×\u0000\u0016h}u×\u00005\b�>*\u0001Z\b�\\\b�^J\u0003\u0000\u0000\u0013\u0015h}u×\u0000\u0016h}u×\u0000Z\b�^J\u0003\u0000\u0016\u0015h}u×\u0000\u0016h}u×\u0000Z\b�^J\u0003\u0000o(\u0002\u0000 \u0015h}u×\u0000\u0016h}u×\u00005\b�>*\u0001Z\b�\\\b�^J\u0003\u0000o(\u0002\u0016\u0016h}u×\u00005\b�Z\b�\\\b�^J\u0003\u0000o(\u0002\u0000 \u0015h}u×\u0000\u0016h}u×\u00005\b�Z