 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000ג\u0005ז\u0005�\u0005ױ\u0005.\u0000 \u0000�\u0005י\u0005 \u0000ׁ\u0005ג\u0005ז\u0005�\u0005 \u0000י\u0005ך\u0005�\u0005 \u0000׃\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005ך\u0005ױ\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005ױ\u0005׃\u0005י\u0005 \u0000װ\u0005ײ\u0005װ\u0005.\u0000 \u0000׀\u0005ה\u0005י\u0005ט\u0005 \u0000�\u0005ה\u0005ך\u0005ױ\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000ׁ\u0005ז\u0005ױ\u0005 \u0000ױ\u0005׀\u0005ה\u0005י\u0005ט\u0005 \u0000�\u0005ה\u0005ך\u0005ױ\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000ׁ\u0005�\u0005ב\u0005ׂ\u0005ט\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000י\u0005ׁ\u0005׃\u0005�\u0005ױ\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000ך\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005ײ\u0005װ\u0005 \u0000ך\u0005ױ\u0005ח\u0005ד\u0005 \u0000ט\u0005״\u0005ט\u0005ױ\u0005׀\u0005ח\u0005״\u0005�\u0005ׁ\u0005�\u0005.\u0000 \u0000�\u0005י\u0005�\u0005׳\u0005ױ\u0005ך\u0005 \u0000י\u0005ג\u0005י\u0005�\u0005א\u0005ױ\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005ג\u0005ו\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000װ\u0005ׂ\u0005ג\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005ב\u0005ח\u0005א\u0005װ\u0005 \u0000י\u0005�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ח\u0005�\u0005,\u0000 \u0000ה\u0005׳\u0005ױ\u0005ך\u0005 \u0000�\u0005ב\u0005ױ\u0005ׁ\u0005�\u0005 \u0000�\u0005ג\u0005י\u0005ױ\u0005ך\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005׳\u0005ױ\u0005׃\u0005י\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ז\u0005ױ\u0005.\u0000\n\u0000\n\u0000<\u0000�\u0005ג\u0005ט\u0005װ\u0005 \u0000�\u0005�\u0005ׁ\u0005ט\u0005ׂ\u0005ט\u0005:\u0000>\u0000\n\u0000\n\u0000װ\u0005ך\u0005י\u0005ױ\u0005ׁ\u0005װ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000א