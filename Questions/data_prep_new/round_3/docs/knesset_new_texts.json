�\u0005ׁ\u0005ױ\u0005׃\u0005,\u0000 \u0000װ\u0005�\u0005י\u0005ה\u0005׳\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000ג\u0005י\u0005ך\u0005װ\u0005 \u0000ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005 \u0000״\u0005ױ\u0005ׁ\u0005װ\u0005,\u0000 \u0000ױ\u0005ׂ\u0005�\u0005 \u0000ׁ\u0005�\u0005׳\u0005\"\u0000�\u0005 \u0000װ\u0005�\u0005ױ\u0005 \u0000׀\u0005א\u0005י\u0005�\u0005�\u0005 \u0000״\u0005ױ\u0005ׁ\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000ט\u0005ח\u0005 \u0000ׁ\u0005ה\u0005�\u0005�\u0005\"\u0000׳\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000י\u0005�\u0005׳\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005ױ\u0005ך\u0005ד\u0005 \u0000׀\u0005�\u0005ך\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005ג\u0005י\u0005ױ\u0005ך\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000י\u0005׀\u0005ך\u0005�\u0005 \u0000ג\u0005ױ\u0005י\u0005�\u0005�\u0005 \u0000ה\u0005װ\u0005 \u0000ׁ\u0005א\u0005ז\u0005ט\u0005ך\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000׀\u0005ײ\u0005ױ\u0005ט\u0005 \u0000י\u0005�\u0005ך\u0005ג\u0005א\u0005�\u0005�\u0005א\u0005�\u0005�\u0005 \u0000ׁ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005 \u0000ױ\u0005�\u0005י\u0005 \u0000�\u0005�\u0005 \u0000ך\u0005׳\u0005ױ\u0005י\u0005װ\u0005 \u0000�\u0005ײ\u0005װ\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000�\u0005ׂ\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005ׂ\u0005�\u0005 \u0000�\u0005א\u0005ז\u0005ט\u0005ך\u0005.\u0000\n\u0000\n\u0000�\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005 \u0000י\u0005׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005׳\u0005�\u0005 \u0000�\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ז\u0005�\u0005׳\u0005װ\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000ׁ\u0005״\u0005ױ\u0005׳\u0005 \u0000י\u0005ך\u0005ז\u0005�\u0005�\u0005׳\u0005ױ\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ׁ\u0005�\u0005׳\u0005׃\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000׀\u0005ך\u0005�\u0005 \u0000ך\u0005ױ\u0005ׁ\u0005�\u0005�\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005 \u0000ׁ\u0005י\u0005״\u0005׳\u0005 \u0000װ\u0005ײ\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000י\u0005״\u0005׳\u0005 \u0000י\u0005�\u0005�\u0005�\u0005.\u0000 \u0000�\u0005�\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005׃\u0005ג\u0005ך\u0005 \u0000�\u0005װ\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005ױ\u0005׃\u0005ג\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000׀\u0005ױ\u0005�\u0005�\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005.\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ױ\u0005�\u0005װ\u0005ך\u0005ט\u0005׀\u0005ױ\u0005ך\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000�\u0005ב\u0005״\u0005ד\u0005.\u0000 \u0000\n\u0000\n\u0000װ\u0005ײ\u0005װ\u0005�\u0005ט\u0005ױ\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005 \u0000�\u0005ח\u0005ױ\u0005׃\u0005�\u0005 \u0000י\u0005׀\u0005א\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ג\u0005�\u0005ױ\u0005׃\u0005 \u0000ׁ\u0005�\u0005ױ\u0005׳\u0005ױ\u0005ך\u0005 \u0000ײ\u0005�\u0005א\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005ײ\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000׀\u0005י\u0005ך\u0005׃\u0005�\u0005.\u0000 \u0000�\u0005י\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ג\u0005ױ\u0005׃\u0005 \u0000י\u0005א\u0005�\u0005 \u0000׳\u0005�\u0005ח\u0005�\u0005�\u0005 \u0000ח\u0005״\u0005א\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005׳\u0005׃\u0005 \u0000 \u0000ײ\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005 \u0000׳\u0005�\u0005ױ\u0005ח\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ט\u0005ז\u0005ױ\u0005�\u0005 \u0000ױ\u0005ט\u0005׀\u0005ױ\u0005�\u0005 \u0000י\u0005י\u0005א\u0005�\u0005 \u0000א\u0005ז\u0005�\u0005ׂ\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005 \u0000�\u0005ׂ\u0005�\u0005׃\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000׃\u0005ׁ\u0005ט\u0005�\u0005װ\u0005�\u0005.\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ב\u0005ׁ\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005 \u0000�\u0005�\u0005 \u0000ח\u0005ױ\u0005׃\u0005�\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ב\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005 \u0000׀\u0005ך\u0005װ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005׃\u0005 \u0000ח\u0005ױ\u0005׃\u0005�\u0005?\u0000 \u0000ט\u0005ח\u0005 \u0000׀\u0005�\u0005 \u0000ך\u0005ט\u0005�\u0005ׁ\u0005ױ\u0005,\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005װ\u0005 \u0000ח\u0005ױ\u0005׀\u0005�\u0005�\u0005ז\u0005�\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000\n\u0000\n\u0000<\u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005׃\u0005ױ\u0005א\u0005�\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005,\u0000 \u0000װ\u0005ט\u0005ז\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ך\u0005ג\u0005י\u0005�\u0005�\u0005װ\u0005 \u0000װ\u0005�\u0005י\u0005ט\u0005׀\u0005�\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005׳\u0005׃\u0005 \u0000�\u0005װ\u0005ז\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000װ\u0005ׂ\u0005׃\u0005ױ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ב\u0005״\u0005ד\u0005 \u0000ױ\u0005ט\u0005״\u0005װ\u0005�\u0005�\u0005�\u0005ט\u0005.\u0000 \u0000�\u0005י\u0005 \u0000�\u0005�\u0005 \u0000ך\u0005�\u0005�\u0005׃\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005 \u0000�\u0005י\u0005׀\u0005א\u0005�\u0005 \u0000א\u0005�\u0005ז\u0005׀\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000�\u0005י\u0005װ\u0005�\u0005�\u0005ך\u0005 \u0000ׁ\u0005�\u0005א\u0005ב\u0005ך\u0005.\u0000 \u0000׃\u0005�\u0005ׁ\u0005ט\u0005ך\u0005 \u0000׀\u0005ׁ\u0005�\u0005 \u0000ג\u0005י\u0005�\u0005ך\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005.\u0000 \u0000\n\u0000\n\u0000ג\u0005י\u0005ט\u0005 \u0000י\u0005א\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000י\u0005א\u0005ױ\u0005�\u0005׃\u0005ך\u0005�\u0005,\u0000 \u0000�\u0005ח\u0005�\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005 \u00002\u00000\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000׀\u0005�\u0005י\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000א\u0005ױ\u0005�\u0005׃\u0005ך\u0005�\u0005 \u0000ׁ\u0005-\u00001\u00009\u00003\u00009\u0000 \u0000ױ\u0005װ\u0005�\u0005י\u0005ה\u0005׳\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005ך\u0005װ\u0005,\u0000 \u0000װ\u0005�\u0005׀\u0005 \u0000ג\u0005�\u0005ך\u0005װ\u0005 \u0000�\u0005׀\u0005ט\u0005ו\u0005 \u0000�\u0005ױ\u0005ױ\u0005�\u0005�\u0005א\u0005׀\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005׀\u0005׳\u0005ט\u0005ױ\u0005א\u0005װ\u0005,\u0000 \u0000׀\u0005�\u0005׀\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000ג\u0005�\u0005ך\u0005װ\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u00002\u00000\u00005\u0000 \u0000י\u0005א\u0005�\u0005�\u0005 \u0000ױ\u0005װ\u0005�\u0005׳\u0005�\u0005׃\u0005�\u0005�\u0005 \u0000י\u0005ח\u0005�\u0005ׁ\u0005�\u0005ױ\u0005 \u0000׀\u0005ױ\u0005ך\u0005א\u0005ױ\u0005 \u0000ה\u0005װ\u0005 \u0000ׁ\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005א\u0005�\u0005 \u0000׃\u0005ױ\u0005׃\u0005�\u0005א\u0005ױ\u0005 \u0000װ\u0005ג\u0005ט\u0005ׁ\u0005�\u0005�\u0005 \u0000י\u0005ח\u0005�\u0005ׁ\u0005�\u0005ױ\u0005 \u0000׀\u0005ױ\u0005ך\u0005א\u0005ױ\u0005 \u0000ׁ\u0005י\u0005�\u0005׳\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005 \u0000�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000ׂ\u0005׃\u0005�\u0005װ\u0005,\u0000 \u0000װ\u0005�\u0005׀\u0005 \u0000װ\u0005�\u0005�\u0005ך\u0005װ\u0005 \u0000ג\u0005׃\u0005 \u0000׀\u0005ײ\u0005 \u00001\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000׀\u0005�\u0005י\u0005 \u0000ױ\u0005׀\u0005׳\u0005�\u0005א\u0005ױ\u0005 \u0000װ\u0005ב\u0005ה\u0005ט\u0005׃\u0005�\u0005�\u0005,\u0000 \u0000�\u0005י\u0005ה\u0005׳\u0005ך\u0005 \u0000�\u0005ױ\u0005ב\u0005�\u0005ױ\u0005ד\u0005,\u0000 \u0000י\u0005׀\u0005׳\u0005ט\u0005 \u0000�\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ײ\u0005�\u0005�\u0005א\u0005ױ\u0005 \u0000�\u0005ח\u0005ׁ\u0005�\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005,\u0000 \u0000ױ\u0005�\u0005׀\u0005ײ\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005ױ\u0005׃\u0005ג\u0005�\u0005�\u0005 \u0000י\u0005�\u0005�\u0005 \u0000׃\u0005ױ\u0005ט\u0005 \u0000י\u0005ח\u0005׃\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005ׁ\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׃\u0005ױ\u0005ט\u0005 \u0000י\u0005ׁ\u0005׀\u0005 \u0000׀\u0005׳\u0005ט\u0005�\u0005ױ\u0005.\u0000 \u0000\n\u0000\n\u0000װ\u0005�\u0005�\u0005ך\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ג\u0005�\u0005�\u0005�\u0005ך\u0005 \u0000ט\u0005׀\u0005י\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000ױ\u0005װ\u0005�\u0005�\u0005ך\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ג\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000ט\u0005׀\u0005י\u0005ױ\u0005א\u0005װ\u0005 \u0000ױ\u0005װ\u0005�\u0005�\u0005ך\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ג\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005ג\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005,\u0000 \u0000ט\u0005ׁ\u0005�\u0005ג\u0005�\u0005ך\u0005 \u0000ױ\u0005׳\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005׀\u0005װ\u0005.\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ז\u0005ה\u0005ױ\u0005�\u0005 \u0000׀\u0005ה\u0005ט\u0005�\u0005ח\u0005װ\u0005,\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005ח\u0005ױ\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000�\u0005�\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000י\u0005א\u0005ױ\u0005�\u0005׃\u0005ך\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u00005\u00000\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005�\u0005 \u0000ױ\u0005ׁ\u0005י\u0005א\u0005ך\u0005 \u00004\u00008\u0000'\u0000,\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000װ\u0005�\u0005ט\u0005ײ\u0005א\u0005ױ\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005ח\u0005�\u0005ך\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000װ\u0005�\u0005ױ\u0005 \u00008\u00000\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000ׁ\u0005�\u0005 \u0000ך\u0005י\u0005ג\u0005 \u0000ױ\u0005װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000װ\u0005ׂ\u0005�\u0005ג\u0005װ\u0005 \u0000�\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005י\u0005׀\u0005�\u0005ױ\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005,\u0000 \u0000'\u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005װ\u0005 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005?\u0000'\u0000 \u0000׀\u0005ײ\u0005 \u0000ׁ\u0005׀\u0005ך\u0005�\u0005ױ\u0005ה\u0005�\u0005װ\u0005 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000�\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005,\u0000 \u0000�\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005ג\u0005י\u0005ױ\u0005ך\u0005?\u0000 \u0000�\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000ׁ\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000׃\u0005ױ\u0005ט\u0005 \u0000י\u0005ׁ\u0005�\u0005ג\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000'\u0000�\u0005װ\u0005 \u0000׀\u0005ך\u0005�\u0005 \u0000�\u0005ך\u0005�\u0005ױ\u0005ױ\u0005א\u0005�\u0005�\u0005,\u0000 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005?\u0000 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005 \u0000װ\u0005ך\u0005ׂ\u0005י\u0005�\u0005 \u0000�\u0005׳\u0005׃\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005,\u0000 \u0000ח\u0005�\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000�\u0005׃\u0005�\u0005א\u0005װ\u0005,\u0000 \u0000�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005'\u0000,\u0000 \u0000׀\u0005�\u0005ט\u0005ױ\u0005 \u0000�\u0005�\u0005,\u0000 \u0000'\u0000�\u0005׀\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ט\u0005ױ\u0005׀\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005�\u0005 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ׂ\u0005�\u0005ג\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000�\u0005א\u0005ב\u0005ך\u0005?\u0000'\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000'\u0000�\u0005׀\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005ׂ\u0005�\u0005ױ\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ׂ\u0005�\u0005�\u0005א\u0005ב\u0005�\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ז\u0005ׁ\u0005׀\u0005,\u0000 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ח\u0005ז\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005׳\u0005ט\u0005 \u0000�\u0005�\u0005�\u0005 \u0000�\u0005�\u0005�\u0005ױ\u0005׃\u0005 \u0000�\u0005י\u0005ה\u0005״\u0005�\u0005�\u0005'\u0000,\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000�\u0005�\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000ך\u0005�\u0005א\u0005�\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005ג\u0005א\u0005�\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005,\u0000 \u0000'\u0000�\u0005׀\u0005׳\u0005ט\u0005 \u0000�\u0005�\u0005�\u0005 \u0000׀\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000׀\u0005ט\u0005ז\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ה\u0005ױ\u0005�\u0005�\u0005״\u0005�\u0005ח\u0005װ\u0005,\u0000 \u0000�\u0005װ\u0005�\u0005�\u0005א\u0005ב\u0005 \u0000�\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000׳\u0005�\u0005ױ\u0005�\u0005 \u0000ׁ\u0005י\u0005ׁ\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005'\u0000,\u0000 \u0000׀\u0005�\u0005ט\u0005ױ\u0005 \u0000'\u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005ט\u0005?\u0000'\u0000 \u0000�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005׃\u0005 \u0000װ\u0005ׁ\u0005�\u0005ך\u0005 \u0000י\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000ׂ\u0005ט\u0005ױ\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000י\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005�\u0005 \u0000ׂ\u0005ױ\u0005ט\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000ׂ\u0005ױ\u0005�\u0005׃\u0005װ\u0005,\u0000 \u0000ב\u0005ה\u0005�\u0005ט\u0005,\u0000 \u0000׀\u0005י\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005�\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000ׂ\u0005ט\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000'\u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005ט\u0005 \u0000ײ\u0005װ\u0005 \u0000״\u0005ױ\u0005ׁ\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005,\u0000 \u0000�\u0005�\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000�\u0005י\u0005 \u0000�\u0005ױ\u0005 \u0000׀\u0005ױ\u0005״\u0005ױ\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000א\u0005ױ\u0005׳\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000ׁ\u0005י\u0005ׁ\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000׳\u0005�\u0005ױ\u0005�\u0005'\u0000.\u0000 \u0000ׁ\u0005י\u0005ׁ\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000׳\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005״\u0005ג\u0005�\u0005 \u0000 \u0000װ\u0005ה\u0005י\u0005ױ\u0005״\u0005,\u0000 \u0000י\u0005ז\u0005ט\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ג\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000ח\u0005ז\u0005ך\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ח\u0005י\u0005װ\u0005.\u0000 \u0000׀\u0005�\u0005ט\u0005ױ\u0005 \u0000�\u0005�\u0005 \u0000'\u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005׀\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005?\u0000'\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005,\u0000 \u0000'\u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000�\u0005א\u0005ב\u0005ך\u0005?\u0000'\u0000 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000י\u0005ה\u0005ט\u0005�\u0005א\u0005ז\u0005ח\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005�\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000׀\u0005�\u0005י\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005 \u0000�\u0005�\u0005ױ\u0005ׁ\u0005׃\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005,\u0000 \u0000�\u0005ױ\u0005�\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005ׁ\u0005׃\u0005א\u0005ױ\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005,\u0000 \u0000ׂ\u0005�\u0005,\u0000 \u0000'\u0000�\u0005�\u0005ט\u0005ױ\u0005ך\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000א\u0005ה\u0005�\u0005׀\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000׳\u0005�\u0005ױ\u0005�\u0005'\u0000,\u0000 \u0000׀\u0005ײ\u0005 \u0000׀\u0005�\u0005ט\u0005ױ\u0005 \u0000�\u0005�\u0005,\u0000 \u0000'\u0000׀\u0005ײ\u0005 \u0000�\u0005װ\u0005 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005,\u0000 \u0000�\u0005�\u0005׃\u0005?\u0000'\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005,\u0000 \u0000'\u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005 \u0000י\u0005ׁ\u0005י\u0005א\u0005ך\u0005 \u00002\u00000\u00000\u00000\u0000,\u0000 \u0000ג\u0005ױ\u0005׃\u0005 \u00005\u00000\u0000 \u0000י\u0005א\u0005װ\u0005,\u0000 \u0000�\u0005װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005 \u0000י\u0005א\u0005�\u0005 \u0000�\u0005�\u0005�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005�\u0005'\u0000.\u0000 \u0000ׁ\u0005י\u0005א\u0005ך\u0005 \u00002\u00000\u00000\u00000\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000י\u0005�\u0005י\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005,\u0000 \u0000ׁ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005ך\u0005 \u0000ױ\u0005׃\u0005�\u0005ױ\u0005ח\u0005ט\u0005״\u0005�\u0005ך\u0005 \u0000י\u0005ׁ\u0005װ\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000י\u0005א\u0005�\u0005 \u0000�\u0005�\u0005�\u0005�\u0005ױ\u0005�\u0005 \u0000ג\u0005ט\u0005ׁ\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000װ\u0005�\u0005 \u0000י\u0005ױ\u0005ך\u0005ה\u0005�\u0005�\u0005 \u0000�\u0005ג\u0005ױ\u0005ׁ\u0005׃\u0005װ\u0005 \u0000י\u0005װ\u0005�\u0005ױ\u0005�\u0005׃\u0005ך\u0005 \u0000י\u0005�\u0005א\u0005ױ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000�\u0005ױ\u0005�\u0005׃\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005 \u0000װ\u0005�\u0005װ\u0005ױ\u0005׃\u0005�\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005 \u0000י\u0005ײ\u0005ױ\u0005 \u0000ׂ\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005׃\u0005ך\u0005 \u0000י\u0005�\u0005װ\u0005�\u0005,\u0000 \u0000�\u0005װ\u0005״\u0005ג\u0005�\u0005 \u0000װ\u0005ה\u0005י\u0005ױ\u0005״\u0005 \u0000י\u0005װ\u0005�\u0005 \u0000א\u0005ױ\u0005�\u0005׃\u0005ױ\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005�\u0005ז\u0005ױ\u0005׀\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ׂ\u0005י\u0005ט\u0005 \u0000�\u0005׳\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005׳\u0005׃\u0005.\u0000 \u0000\n\u0000\n\u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000י\u0005א\u0005�\u0005ז\u0005׀\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ׂ\u0005י\u0005ט\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000א\u0005�\u0005ז\u0005׀\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000ׁ\u0005ט\u0005ׁ\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000װ\u0005�\u0005 \u0000�\u0005ט\u0005ז\u0005ױ\u0005,\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005�\u0005ז\u0005ױ\u0005׀\u0005 \u0000׃\u0005ױ\u0005ט\u0005 \u0000�\u0005׃\u0005ױ\u0005ט\u0005 \u0000ױ\u0005ג\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005ג\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ׂ\u0005י\u0005ט\u0005 \u0000ׁ\u0005�\u0005א\u0005�\u0005א\u0005ױ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005,\u0000 \u0000א\u0005ח\u0005י\u0005ט\u0005װ\u0005 \u0000א\u0005ה\u0005י\u0005�\u0005,\u0000 \u0000�\u0005׳\u0005׃\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005ט\u0005�\u0005 \u0000ױ\u0005ט\u0005ׁ\u0005�\u0005,\u0000 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005�\u0005י\u0005�\u0005װ\u0005 \u0000�\u0005י\u0005ג\u0005ׁ\u0005ט\u0005,\u0000 \u0000�\u0005ז\u0005׳\u0005ח\u0005 \u0000י\u0005�\u0005�\u0005ט\u0005,\u0000 \u0000י\u0005ט\u0005׀\u0005װ\u0005 \u0000ׁ\u0005ג\u0005�\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000י\u0005�\u0005 \u0000�\u0005װ\u0005׃\u0005ױ\u0005ך\u0005 \u0000׀\u0005ך\u0005�\u0005ױ\u0005ה\u0005�\u0005װ\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ך\u0005ט\u0005,\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000װ\u0005ך\u0005ה\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005׀\u0005ט\u0005ו\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005,\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000װ\u0005ך\u0005ה\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005י\u0005ױ\u0005�\u0005 \u0000י\u0005׀\u0005ך\u0005�\u0005,\u0000 \u0000ׁ\u0005�\u0005�\u0005 \u0000י\u0005װ\u0005ׁ\u0005א\u0005ך\u0005�\u0005 \u0000�\u0005װ\u0005 \u0000ײ\u0005ױ\u0005 \u0000װ\u0005ז\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005�\u0005ך\u0005 \u0000ױ\u0005�\u0005װ\u0005 \u0000ײ\u0005ױ\u0005 \u0000װ\u0005ז\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005�\u0005ב\u0005״\u0005�\u0005ך\u0005 \u0000ױ\u0005�\u0005װ\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ז\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005י\u0005�\u0005�\u0005ך\u0005�\u0005ך\u0005 \u0000ױ\u0005�\u0005װ\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ז\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׳\u0005ח\u0005�\u0005׀\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000װ\u0005ׁ\u0005א\u0005ך\u0005�\u0005 \u0000י\u0005׀\u0005�\u0005�\u0005 \u0000ז\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000ז\u0005�\u0005ױ\u0005�\u0005 \u0000ױ\u0005ז\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005.\u0000 \u0000ױ\u0005�\u0005י\u0005 \u0000ח\u0005י\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ח\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005�\u0005ױ\u0005״\u0005 \u0000׀\u0005ך\u0005�\u0005�\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000׳\u0005י\u0005ׁ\u0005ך\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000 \u0000ױ\u0005�\u0005א\u0005װ\u0005�\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005 \u0000ױ\u0005׀\u0005�\u0005ט\u0005ױ\u0005 \u0000י\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005ׂ\u0005ױ\u0005י\u0005 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000׀\u0005י\u0005ט\u0005 \u0000�\u0005י\u0005ך\u0005�\u0005ׁ\u0005�\u0005�\u0005 \u0000ׁ\u0005ך\u0005ױ\u0005�\u0005 \u0000װ\u0005׳\u0005ׁ\u0005ט\u0005װ\u0005,\u0000 \u0000ׁ\u0005�\u0005ז\u0005ׁ\u0005�\u0005�\u0005 \u0000װ\u0005ח\u0005י\u0005�\u0005�\u0005 \u0000י\u0005ׁ\u0005װ\u0005�\u0005 \u0000װ\u0005ג\u0005׃\u0005װ\u0005 \u0000א\u0005�\u0005ז\u0005׀\u0005ך\u0005 \u0000ױ\u0005׀\u0005�\u0005 \u0000׀\u0005ה\u0005י\u0005ט\u0005 \u0000�\u0005װ\u0005ך\u0005ג\u0005�\u0005�\u0005 \u0000�\u0005ײ\u0005װ\u0005,\u0000 \u0000ױ\u0005י\u0005�\u0005ג\u0005ך\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000ׁ\u0005װ\u0005׳\u0005�\u0005״\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005�\u0005י\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ח\u0005י\u0005�\u0005�\u0005�\u0005 \u0000ט\u0005ׁ\u0005�\u0005�\u0005 \u0000י\u0005ׁ\u0005�\u0005א\u0005�\u0005װ\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000׃\u0005ױ\u0005׳\u0005ח\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005ך\u0005א\u0005ױ\u0005 \u0000ה\u0005ך\u0005ט\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ח\u0005י\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005ױ\u0005ז\u0005ט\u0005�\u0005�\u0005 \u0000ה\u0005ך\u0005ט\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000ח\u0005�\u0005�\u0005�\u0005 \u0000י\u0005׀\u0005�\u0005א\u0005�\u0005 \u0000״\u0005ױ\u0005ׁ\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000׳\u0005ױ\u0005ו\u0005 \u0000ױ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000�\u0005ױ\u0005׃\u0005ג\u0005 \u0000י\u0005װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000�\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005ט\u0005 \u0000װ\u0005װ\u0005�\u0005ך\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005׳\u0005ׁ\u0005ט\u0005װ\u0005 \u0000ׁ\u0005�\u0005י\u0005ט\u0005׀\u0005�\u0005,\u0000 \u0000�\u0005ױ\u0005ט\u0005 \u0000װ\u0005װ\u0005�\u0005ך\u0005ױ\u0005�\u0005 \u0000י\u0005װ\u0005ױ\u0005׀\u0005 \u0000װ\u0005ז\u0005ׁ\u0005׀\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005ה\u0005ג\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ך\u0005ג\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005י\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005 \u0000�\u0005ה\u0005ך\u0005ױ\u0005ט\u0005 \u0000ה\u0005ך\u0005ט\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000ח\u0005�\u0005�\u0005�\u0005.\u0000\n\u0000\n\u0000ױ\u0005׀\u0005ך\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005ז\u0005�\u0005ח\u0005 \u0000ױ\u0005׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005,\u0000 \u0000�\u0005װ\u0005ט\u0005ׂ\u0005�\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ג\u0005�\u0005ױ\u0005ך\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000ׁ\u0005ח\u0005ױ\u0005׃\u0005י\u0005,\u0000 \u0000�\u0005׳\u0005׃\u0005 \u0000ג\u0005�\u0005 \u0000׀\u0005א\u0005י\u0005�\u0005�\u0005 \u0000״\u0005ױ\u0005ׁ\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005ג\u0005ױ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000�\u0005ױ\u0005ז\u0005ט\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005ױ\u0005ט\u0005 \u0000װ\u0005װ\u0005�\u0005ך\u0005ױ\u0005�\u0005.\u0000 \u0000א\u0005�\u0005ױ\u0005�\u0005,\u0000 \u00002\u00001\u0000,\u0000 \u0000ױ\u0005ג\u0005ױ\u0005׃\u0005 \u00002\u00001\u0000 \u0000ױ\u0005ג\u0005ױ\u0005׃\u0005 \u00002\u00001\u0000 \u0000ױ\u0005ג\u0005ױ\u0005׃\u0005 \u00002\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000ױ\u0005ג\u0005ױ\u0005׃\u0005 \u00004\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000ױ\u0005ג\u0005ױ\u0005׃\u0005 \u00006\u00000\u0000,\u00000\u00000\u00000\u0000,\u0000 \u0000�\u0005�\u0005 \u0000ׁ\u0005ױ\u0005א\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005׀\u0005ך\u0005�\u0005 \u0000װ\u0005א\u0005װ\u0005 \u0000�\u0005װ\u0005ב\u0005�\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005ױ\u0005ׁ\u0005ג\u0005�\u0005 \u0000ׁ\u0005ה\u0005א\u0005�\u0005�\u0005�\u0005.\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000׀\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000א\u0005�\u0005ז\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005ט\u0005ׂ\u0005ג\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000װ\u0005�\u0005ב\u0005ה\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005׳\u0005ט\u0005�\u0005 \u0000װ\u0005ז\u0005װ\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005ױ\u0005ך\u0005 \u0000׳\u0005ױ\u0005ו\u0005 \u0000ױ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ה\u0005י\u0005ױ\u0005״\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005א\u0005ױ\u0005י\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׳\u0005י\u0005ׁ\u0005ך\u0005�\u0005 \u0000י\u0005װ\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000�\u0005ׁ\u0005׳\u0005�\u0005א\u0005ך\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000׳\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000װ\u0005א\u0005װ\u0005 \u0000ױ\u0005�\u0005ׁ\u0005ט\u0005�\u0005 \u0000׀\u0005ך\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000ױ\u0005ג\u0005�\u0005 \u0000װ\u0005-\u00003\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000׃\u0005ױ\u0005�\u0005ט\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000י\u0005ױ\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005׳\u0005�\u0005�\u0005�\u0005 \u0000י\u0005�\u0005�\u0005,\u0000 \u0000�\u0005ח\u0005�\u0005ט\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005,\u0000 \u0000ױ\u0005װ\u0005א\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000�\u0005�\u0005ט\u0005ך\u0005 \u0000ׁ\u0005-\u00003\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000׃\u0005ױ\u0005�\u0005ט\u0005.\u0000 \u0000ױ\u0005װ\u0005׃\u0005ױ\u0005�\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005�\u0005�\u0005,\u0000 \u0000װ\u0005ט\u0005ז\u0005ױ\u0005�\u0005 \u0000װ\u0005א\u0005ה\u0005�\u0005׀\u0005 \u0000י\u0005�\u0005 \u0000�\u0005�\u0005 \u0000י\u0005ײ\u0005�\u0005ך\u0005װ\u0005 \u0000ׁ\u0005-\u00005\u0000,\u00000\u00000\u00000\u0000 \u0000י\u0005ח\u0005�\u0005 \u0000ה\u0005ט\u0005ב\u0005 \u0000ױ\u0005ׁ\u0005�\u0005ח\u0005י\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005ך\u0005א\u0005ױ\u0005 \u0000�\u0005װ\u0005 \u0000ׁ\u0005ׁ\u0005�\u0005ך\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005 \u0000י\u0005ׁ\u0005ױ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000ך\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ג\u0005ׁ\u0005ױ\u0005׃\u0005.\u0000 \u0000ײ\u0005װ\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000ׂ\u0005׀\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ה\u0005װ\u0005 \u0000׀\u0005�\u0005ך\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005:\u0000>\u0000\n\u0000\n\u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005,\u0000 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005:\u0000>\u0000\n\u0000\n\u0000׳\u0005ׁ\u0005ט\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005ױ\u0005ׁ\u0005׃\u0005,\u0000 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005ױ\u0005ט\u0005׳\u0005 \u0000װ\u0005�\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000ב\u0005״\u0005ד\u0005 \u0000ױ\u0005ט\u0005״\u0005װ\u0005�\u0005�\u0005�\u0005ט\u0005,\u0000 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000א\u0005�\u0005ׁ\u0005׃\u0005�\u0005�\u0005.\u0000 \u0000ח\u0005ױ\u0005׃\u0005�\u0005 \u0000�\u0005�\u0005 \u0000ח\u0005י\u0005װ\u0005 \u0000�\u0005׃\u0005ׁ\u0005ט\u0005 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005.\u0000 \u0000ײ\u0005װ\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000א\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005י\u0005װ\u0005ױ\u0005 \u0000�\u0005ז\u0005׳\u0005�\u0005ח\u0005,\u0000 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005א\u0005װ\u0005 \u0000װ\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005ׂ\u0005�\u0005ג\u0005 \u0000�\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ׁ\u0005ך\u0005ױ\u0005ט\u0005 \u0000ב\u0005ה\u0005ױ\u0005ט\u0005״\u0005׀\u0005�\u0005 \u0000�\u0005י\u0005ג\u0005ׁ\u0005ט\u0005,\u0000 \u0000ױ\u0005׀\u0005ײ\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005א\u0005װ\u0005 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005 \u0000ה\u0005א\u0005װ\u0005 \u0000׀\u0005�\u0005�\u0005�\u0005,\u0000 \u0000'\u0000�\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000װ\u0005�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005'\u0000,\u0000 \u0000׀\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000�\u0005ױ\u0005 \u0000'\u0000ט\u0005ױ\u0005ׁ\u0005�\u0005,\u0000 \u0000ך\u0005ה\u0005ב\u0005�\u0005ח\u0005 \u0000�\u0005ח\u0005ט\u0005ױ\u0005׀\u0005 \u0000�\u0005�\u0005 \u0000�\u0005�\u0005װ\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000א\u0005ג\u0005�\u0005�\u0005 \u0000�\u0005�\u0005,\u0000 \u0000�\u0005ׁ\u0005׳\u0005�\u0005א\u0005ך\u0005�\u0005 \u0000ט\u0005ױ\u0005ׁ\u0005�\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000װ\u0005 \u0000-\u0000 \u0000-\u0000 \u0000-\u0000\n\u0000\n\u0000<\u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ך\u0005׳\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ך\u0005ט\u0005ׂ\u0005�\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000װ\u0005�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ט\u0005׀\u0005י\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005:\u0000>\u0000\n\u0000\n\u0000�\u0005ך\u0005ט\u0005ׂ\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005״\u0005 \u0000�\u0005׀\u0005״\u0005.\u0000 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ד\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005ט\u0005י\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000�\u0005ח\u0005ױ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000׳\u0005ײ\u0005ױ\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005.\u0000 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000׃\u0005�\u0005ׁ\u0005ט\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005װ\u0005 \u0000׃\u0005ח\u0005ױ\u0005ך\u0005 \u0000ג\u0005�\u0005 \u0000׀\u0005�\u0005ז\u0005�\u0005ח\u0005 \u0000�\u0005ױ\u0005�\u0005 \u0000ױ\u0005װ\u0005ױ\u0005׀\u0005 \u0000׀\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005,\u0000 \u0000'\u0000�\u0005ױ\u0005׀\u0005�\u0005,\u0000 \u0000ך\u0005י\u0005�\u0005ג\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ז\u0005�\u0005ך\u0005�\u0005 \u0000ׁ\u0005ך\u0005ױ\u0005ט\u0005 \u0000ג\u0005ױ\u0005�\u0005װ\u0005 \u0000׳\u0005׃\u0005י\u0005 \u0000�\u0005י\u0005ג\u0005ׁ\u0005ט\u0005 \u0000�\u0005װ\u0005ױ\u0005�\u0005�\u0005׳\u0005 \u0000׀\u0005ך\u0005 \u0000ג\u0005ז\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000ׁ\u0005׀\u0005ט\u0005ו\u0005,\u0000 \u0000ט\u0005ז\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005װ\u0005׳\u0005ײ\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005'\u0000,\u0000 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000�\u0005�\u0005�\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005׳\u0005ױ\u0005י\u0005װ\u0005 \u0000װ\u0005ײ\u0005׀\u0005ך\u0005 \u0000�\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005ך\u0005ױ\u0005ט\u0005 \u0000ג\u0005ױ\u0005�\u0005װ\u0005 \u0000׳\u0005׃\u0005י\u0005,\u0000 \u0000װ\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000�\u0005װ\u0005׳\u0005ײ\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000א\u0005ך\u0005א\u0005װ\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000ױ\u0005�\u0005י\u0005װ\u0005א\u0005ה\u0005ך\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000׃\u0005ׂ\u0005�\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005 \u0000ױ\u0005װ\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000װ\u0005ב\u0005ה\u0005ױ\u0005ט\u0005״\u0005׀\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005 \u0000ז\u0005ג\u0005�\u0005ט\u0005 \u0000י\u0005ײ\u0005�\u0005װ\u0005 \u0000ׁ\u0005ׂ\u0005ׁ\u0005�\u0005ג\u0005 \u0000ג\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005ױ\u0005ׂ\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005ג\u0005�\u0005ט\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ב\u0005״\u0005ט\u0005�\u0005װ\u0005,\u0000 \u0000׀\u0005�\u0005ה\u0005װ\u0005 \u0000י\u0005א\u0005ױ\u0005�\u0005׃\u0005 \u0000װ\u0005�\u0005״\u0005�\u0005ט\u0005,\u0000 \u0000׀\u0005ײ\u0005 \u0000װ\u0005ט\u0005ׂ\u0005י\u0005ך\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000ך\u0005׳\u0005ױ\u0005י\u0005ך\u0005 \u0000װ\u0005ב\u0005�\u0005ה\u0005ױ\u0005ח\u0005 \u0000װ\u0005ײ\u0005װ\u0005.\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000א\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000�\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005׳\u0005ױ\u0005י\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000ױ\u0005׀\u0005ך\u0005 \u0000װ\u0005ב\u0005�\u0005ה\u0005ױ\u0005ח\u0005 \u0000י\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000ג\u0005י\u0005�\u0005ך\u0005 \u0000ה\u0005װ\u0005 \u0000�\u0005י\u0005װ\u0005ױ\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005,\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000ױ\u0005�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005ג\u0005�\u0005�\u0005ך\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005 \u0000ך\u0005�\u0005�\u0005׃\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005 \u0000ׁ\u0005�\u0005׳\u0005׃\u0005,\u0000 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005�\u0005י\u0005 \u0000ה\u0005װ\u0005 \u0000ׂ\u0005�\u0005 \u0000�\u0005ב\u0005ט\u0005 \u0000�\u0005ה\u0005ױ\u0005�\u0005.\u0000 \u0000׀\u0005׳\u0005׃\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005׀\u0005�\u0005א\u0005״\u0005ׂ\u0005ט\u0005ז\u0005�\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ג\u0005ױ\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ך\u0005ױ\u0005�\u0005 \u0000װ\u0005ח\u0005װ\u0005�\u0005�\u0005װ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005�\u0005�\u0005 \u0000�\u0005י\u0005׀\u0005ױ\u0005ד\u0005 \u0000�\u0005ז\u0005׀\u0005ך\u0005 \u0000ױ\u0005�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005ױ\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005 \u0000ױ\u0005א\u0005י\u0005׀\u0005ט\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000�\u0005ׁ\u0005׳\u0005�\u0005א\u0005ך\u0005 \u0000װ\u0005ח\u0005װ\u0005�\u0005�\u0005װ\u0005 \u0000װ\u0005׀\u0005ך\u0005�\u0005ױ\u0005ה\u0005�\u0005ך\u0005 \u0000װ\u0005ה\u0005ױ\u0005י\u0005 \u0000װ\u0005׀\u0005׳\u0005ט\u0005ױ\u0005�\u0005,\u0000 \u0000ױ\u0005ה\u0005װ\u0005 \u0000ױ\u0005ׁ\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005י\u0005א\u0005װ\u0005-\u0000י\u0005א\u0005ך\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005׳\u0005ט\u0005ױ\u0005א\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ױ\u0005׀\u0005װ\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000װ\u0005�\u0005י\u0005ׂ\u0005�\u0005�\u0005 \u0000ױ\u0005ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000�\u0005י\u0005�\u0005ג\u0005ױ\u0005ך\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005ד\u0005 \u0000�\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ײ\u0005׀\u0005ך\u0005.\u0000 \u0000ױ\u0005י\u0005ך\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005�\u0005ׁ\u0005׳\u0005�\u0005א\u0005ך\u0005 \u0000װ\u0005׳\u0005ײ\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005ז\u0005ט\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005�\u0005ז\u0005׀\u0005 \u0000�\u0005׳\u0005ױ\u0005\"\u0000�\u0005 \u0000ױ\u0005�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ג\u0005ז\u0005�\u0005׀\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000װ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005 \u0000�\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000א\u0005ױ\u0005ט\u0005׀\u0005 \u0000׳\u0005י\u0005ױ\u0005ׁ\u0005.\u0000 \u0000�\u0005װ\u0005 \u0000י\u0005׀\u0005ך\u0005�\u0005 \u0000ג\u0005ױ\u0005י\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005,\u0000 \u0000�\u0005�\u0005ױ\u0005 \u0000י\u0005׀\u0005�\u0005ט\u0005ך\u0005�\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000ׂ\u0005�\u0005 \u0000�\u0005ב\u0005ט\u0005 \u0000�\u0005ה\u0005ױ\u0005�\u0005 \u0000ױ\u0005ׂ\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000׳\u0005ײ\u0005ח\u0005 \u0000ׁ\u0005�\u0005ױ\u0005ך\u0005ט\u0005,\u0000 \u0000י\u0005�\u0005׳\u0005ײ\u0005�\u0005ח\u0005 \u0000�\u0005א\u0005ױ\u0005,\u0000 \u0000�\u0005ה\u0005ך\u0005׳\u0005 \u0000ױ\u0005�\u0005ח\u0005׃\u0005�\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005�\u0005׃\u0005�\u0005א\u0005װ\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000�\u0005�\u0005 \u0000װ\u0005ׁ\u0005ג\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005י\u0005 \u0000�\u0005ב\u0005ׁ\u0005�\u0005ׁ\u0005.\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000 \u0000׀\u0005ח\u0005ז\u0005ט\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000׀\u0005׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005�\u0005ד\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005׀\u0005�\u0005.\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005 \u0000װ\u0005י\u0005ױ\u0005ך\u0005ה\u0005�\u0005�\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000�\u0005ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005 \u0000�\u0005\"\u0000�\u0005׃\u0005�\u0005׃\u0005\"\u0000,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000�\u0005�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005ח\u0005�\u0005�\u0005״\u0005װ\u0005,\u0000 \u0000�\u0005ג\u0005�\u0005ט\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005ך\u0005�\u0005\"\u0000ך\u0005.\u0000 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000�\u0005י\u0005 \u0000ה\u0005װ\u0005 \u0000ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005 \u0000�\u0005׃\u0005װ\u0005�\u0005�\u0005װ\u0005,\u0000 \u0000י\u0005�\u0005ך\u0005ױ\u0005ד\u0005 \u0000ה\u0005ג\u0005ױ\u0005�\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ך\u0005�\u0005�\u0005׃\u0005 \u0000ט\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ך\u0005ױ\u0005ד\u0005 \u0000ה\u0005ג\u0005ױ\u0005�\u0005װ\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000װ\u0005ׂ\u0005ױ\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005׀\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ט\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ך\u0005ױ\u0005ד\u0005 \u0000ה\u0005ג\u0005ױ\u0005�\u0005װ\u0005 \u0000׀\u0005�\u0005�\u0005ך\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005״\u0005ױ\u0005׳\u0005 \u0000י\u0005װ\u0005ה\u0005ט\u0005ױ\u0005�\u0005ח\u0005״\u0005 \u0000װ\u0005�\u0005ױ\u0005ה\u0005�\u0005׀\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000�\u0005ז\u0005�\u0005�\u0005׳\u0005,\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000׳\u0005�\u0005�\u0005ׁ\u0005 \u0000�\u0005װ\u0005ז\u0005�\u0005�\u0005׳\u0005.\u0000 \u0000�\u0005װ\u0005 \u0000י\u0005׀\u0005ך\u0005�\u0005 \u0000ג\u0005ױ\u0005י\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000�\u0005׳\u0005�\u0005װ\u0005 \u0000�\u0005י\u0005׀\u0005ױ\u0005�\u0005 \u0000׀\u0005�\u0005ה\u0005װ\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005ח\u0005א\u0005ױ\u0005ך\u0005,\u0000 \u0000�\u0005װ\u0005ׁ\u0005�\u0005׀\u0005 \u0000׀\u0005ך\u0005 \u0000׀\u0005י\u0005ך\u0005�\u0005 \u0000ױ\u0005 \u0000-\u0000 \u0000-\u0000 \u0000-\u0000\n\u0000\n\u0000<\u0000ח\u0005ט\u0005�\u0005׀\u0005װ\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000׀\u0005׳\u0005ט\u0005 \u0000�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005י\u0005װ\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000׀\u0005ױ\u0005װ\u0005ׁ\u0005 \u0000�\u0005װ\u0005ה\u0005ך\u0005�\u0005ג\u0005 \u0000׀\u0005ױ\u0005ך\u0005װ\u0005 \u0000ׁ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005�\u0005 \u0000�\u0005�\u0005 \u0000�\u0005ױ\u0005ז\u0005�\u0005׳\u0005 \u0000ׁ\u0005ײ\u0005װ\u0005.\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005�\u0005י\u0005 \u0000�\u0005ה\u0005ט\u0005ױ\u0005�\u0005ח\u0005״\u0005 \u0000ג\u0005ך\u0005�\u0005׃\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005ׁ\u0005׳\u0005�\u0005א\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000ג\u0005�\u0005�\u0005�\u0005װ\u0005,\u0000 \u0000ח\u0005�\u0005�\u0005״\u0005װ\u0005 \u0000ױ\u0005ך\u0005ה\u0005ױ\u0005ז\u0005ױ\u0005ך\u0005,\u0000 \u0000א\u0005�\u0005ך\u0005�\u0005 \u0000�\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005�\u0005 \u0000װ\u0005ה\u0005�\u0005״\u0005ה\u0005ױ\u0005ט\u0005�\u0005װ\u0005,\u0000 \u0000׀\u0005ך\u0005 \u0000�\u0005�\u0005 \u0000�\u0005װ\u0005 \u0000י\u0005ך\u0005ײ\u0005׃\u0005ח\u0005ח\u0005ױ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005ׁ\u0005׀\u0005�\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005׃\u0005װ\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005ד\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005.\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005.\u0000 \u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005:\u0000>\u0000\n\u0000\n\u0000�\u0005�\u0005ג\u0005״\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ׁ\u0005ב\u0005ױ\u0005ד\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ח\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005׃\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000י\u0005י\u0005�\u0005׳\u0005ך\u0005�\u0005.\u0000 \u0000י\u0005ט\u0005 \u0000װ\u0005׀\u0005ױ\u0005ז\u0005ט\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005 \u0000ׂ\u0005�\u0005,\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000װ\u0005ױ\u0005׃\u0005�\u0005ג\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005�\u0005�\u0005 \u0000י\u0005�\u0005י\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005י\u0005�\u0005ׁ\u0005ך\u0005 \u0000ח\u0005ׁ\u0005�\u0005א\u0005״\u0005 \u0000ׁ\u0005ך\u0005�\u0005 \u0000׀\u0005ׁ\u0005�\u0005ׁ\u0005 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005׀\u0005 \u0000װ\u0005ז\u0005�\u0005�\u0005׳\u0005,\u0000 \u0000׀\u0005ײ\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000׀\u0005ׂ\u0005�\u0005׃\u0005 \u0000�\u0005ױ\u0005 \u0000ט\u0005ח\u0005 \u0000י\u0005װ\u0005װ\u0005ה\u0005ב\u0005׃\u0005 \u0000י\u0005�\u0005ױ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005.\u0000 \u0000׀\u0005ך\u0005װ\u0005 \u0000ך\u0005ׂ\u0005�\u0005׃\u0005 \u0000 \u0000�\u0005ױ\u0005?\u0000 \u0000\n\u0000\n\u0000�\u0005ה\u0005א\u0005�\u0005 \u0000י\u0005א\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005 \u0000�\u0005׳\u0005�\u0005ח\u0005 \u0000װ\u0005׀\u0005׳\u0005ט\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ג\u0005א\u0005ח\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ױ\u0005ז\u0005װ\u0005 \u0000�\u0005ב\u0005ה\u0005ט\u0005 \u0000�\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000׀\u0005�\u0005י\u0005 \u0000י\u0005ה\u0005ׂ\u0005י\u0005ך\u0005�\u0005 \u0000ה\u0005װ\u0005 \u0000ׁ\u0005ג\u0005ט\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000י\u0005א\u0005ך\u0005�\u0005�\u0005�\u0005.\u0000 \u0000װ\u0005ה\u0005ׂ\u0005�\u0005י\u0005װ\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005א\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000׀\u0005�\u0005ך\u0005ױ\u0005 \u0000װ\u0005�\u0005�\u0005ך\u0005װ\u0005 \u0000ׁ\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005�\u0005י\u0005�\u0005 \u0000׀\u0005׳\u0005׃\u0005,\u0000 \u0000ׁ\u0005י\u0005ה\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005ך\u0005ג\u0005ט\u0005ױ\u0005�\u0005װ\u0005 \u0000י\u0005ׁ\u0005א\u0005ח\u0005 \u0000װ\u0005ה\u0005ױ\u0005ג\u0005�\u0005�\u0005�\u0005 \u0000ג\u0005י\u0005װ\u0005 \u0000�\u0005ג\u0005�\u0005ױ\u0005ך\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005ױ\u0005�\u0005�\u0005ױ\u0005 \u0000�\u0005�\u0005�\u0005ױ\u0005ט\u0005 \u0000�\u0005ח\u0005ט\u0005׀\u0005ך\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005י\u0005א\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005�\u0005ױ\u0005ז\u0005ט\u0005�\u0005�\u0005 \u0000י\u0005�\u0005װ\u0005�\u0005.\u0000 \u0000װ\u0005י\u0005ח\u0005״\u0005 \u0000י\u0005װ\u0005�\u0005ט\u0005ך\u0005�\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005,\u0000 \u0000ׁ\u0005׀\u0005ױ\u0005״\u0005ױ\u0005,\u0000 \u0000�\u0005י\u0005א\u0005ב\u0005ג\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005ט\u0005ױ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000�\u0005י\u0005ה\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000׳\u0005י\u0005ׁ\u0005ך\u0005�\u0005 \u0000׀\u0005�\u0005ײ\u0005װ\u0005 \u0000װ\u0005ט\u0005 \u0000ׂ\u0005ג\u0005י\u0005 \u0000�\u0005י\u0005 \u0000י\u0005�\u0005 \u0000ׁ\u0005ה\u0005א\u0005�\u0005�\u0005,\u0000 \u0000ױ\u0005װ\u0005׀\u0005�\u0005י\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000ג\u0005�\u0005׃\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005׳\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ױ\u0005 \u0000ױ\u0005�\u0005�\u0005ט\u0005 \u0000ך\u0005�\u0005י\u0005�\u0005״\u0005�\u0005�\u0005 \u0000ׁ\u0005-\u00003\u00000\u0000,\u00000\u00000\u00000\u0000 \u0000י\u0005ח\u0005�\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000�\u0005ױ\u0005�\u0005,\u0000 \u0000ױ\u0005׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005׀\u0005�\u0005�\u0005 \u0000ׁ\u0005ױ\u0005ׂ\u0005ט\u0005 \u0000�\u0005ך\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005�\u0005א\u0005ױ\u0005 \u0000�\u0005׃\u0005�\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005׃\u0005 \u0000�\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005י\u0005�\u0005 \u0000װ\u0005ׁ\u0005ױ\u0005ׂ\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000�\u0005ױ\u0005װ\u0005א\u0005ב\u0005.\u0000\n\u0000\n\u0000<\u0000�\u0005ױ\u0005װ\u0005א\u0005ב\u0005-\u0000ׁ\u0005ױ\u0005ׂ\u0005ט\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005,\u0000 \u0000ׁ\u0005ױ\u0005ח\u0005ט\u0005 \u0000״\u0005ױ\u0005ׁ\u0005.\u0000 \u0000׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005 \u0000ױ\u0005׀\u0005�\u0005ז\u0005�\u0005ח\u0005 \u0000װ\u0005�\u0005ח\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000�\u0005ט\u0005 \u0000ב\u0005״\u0005ד\u0005,\u0000 \u0000ט\u0005�\u0005,\u0000 \u0000ג\u0005�\u0005ױ\u0005ך\u0005ך\u0005 \u0000�\u0005׃\u0005�\u0005׃\u0005.\u0000 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000ׁ\u0005י\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005ױ\u0005ׂ\u0005ט\u0005�\u0005 \u0000ׁ\u0005�\u0005ך\u0005 \u0000װ\u0005ב\u0005ה\u0005ט\u0005 \u0000M\u0000E\u0000G\u0000E\u0000M\u0000E\u0000R\u0000I\u0000A\u0000.\u0000 \u0000M\u0000E\u0000G\u0000E\u0000M\u0000E\u0000R\u0000I\u0000A\u0000 \u0000ׁ\u0005׀\u0005�\u0005װ\u0005ט\u0005�\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000ׁ\u0005ט\u0005׀\u0005י\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005�\u0005ױ\u0005װ\u0005�\u0005�\u0005 \u0000ׁ\u0005ט\u0005׀\u0005,\u0000 \u0000ײ\u0005װ\u0005 \u0000�\u0005ױ\u0005�\u0005א\u0005ױ\u0005 \u0000�\u0005ױ\u0005׃\u0005ג\u0005�\u0005�\u0005.\u0000 \u0000ׁ\u0005ט\u0005ז\u0005ױ\u0005א\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005 \u0000�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005 \u0000ױ\u0005�\u0005׀\u0005�\u0005ז\u0005�\u0005ח\u0005 \u0000�\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005ח\u0005ט\u0005ׁ\u0005 \u0000�\u0005ׁ\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000י\u0005א\u0005ך\u0005ך\u0005�\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005װ\u0005ײ\u0005׃\u0005�\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ײ\u0005׀\u0005ך\u0005 \u0000�\u0005ט\u0005�\u0005ױ\u0005י\u0005 \u0000�\u0005ח\u0005ז\u0005ױ\u0005ג\u0005 \u0000ױ\u0005׃\u0005ט\u0005�\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005 \u0000�\u0005װ\u0005ט\u0005ׂ\u0005�\u0005י\u0005 \u0000׳\u0005�\u0005ח\u0005 \u0000י\u0005ױ\u0005ױ\u0005װ\u0005 \u0000ׁ\u0005׳\u0005ׁ\u0005ט\u0005װ\u0005 \u0000װ\u0005�\u0005י\u0005ט\u0005׀\u0005�\u0005�\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005ױ\u0005 \u0000ט\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000ײ\u0005׀\u0005ך\u0005 \u0000�\u0005ײ\u0005�\u0005ױ\u0005ך\u0005 \u0000ׂ\u0005׃\u0005ױ\u0005�\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000׳\u0005�\u0005ח\u0005 \u0000�\u0005װ\u0005�\u0005ה\u0005ג\u0005�\u0005 \u0000װ\u0005ז\u0005�\u0005ױ\u0005א\u0005�\u0005 \u0000װ\u0005׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000װ\u0005ײ\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000ׁ\u0005ט\u0005ז\u0005ױ\u0005א\u0005א\u0005ױ\u0005 \u0000�\u0005װ\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005 \u0000�\u0005�\u0005�\u0005�\u0005�\u0005,\u0000 \u0000י\u0005�\u0005�\u0005ױ\u0005ױ\u0005ך\u0005װ\u0005 \u0000׀\u0005ױ\u0005ך\u0005א\u0005ױ\u0005 \u0000�\u0005ז\u0005ג\u0005׃\u0005�\u0005א\u0005ױ\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000ׁ\u0005ט\u0005ׂ\u0005�\u0005י\u0005ױ\u0005ך\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000ױ\u0005ׁ\u0005ך\u0005ׁ\u0005ױ\u0005א\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005׀\u0005�\u0005ט\u0005 \u0000װ\u0005�\u0005ױ\u0005ט\u0005װ\u0005 \u0000װ\u0005�\u0005ח\u0005ט\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000�\u0005�\u0005 \u0000י\u0005ג\u0005ײ\u0005ט\u0005ך\u0005 \u0000�\u0005א\u0005ױ\u0005,\u0000 \u0000א\u0005ך\u0005ך\u0005 \u0000ג\u0005׃\u0005�\u0005ה\u0005ױ\u0005ך\u0005 \u0000�\u0005װ\u0005ז\u0005�\u0005׳\u0005ך\u0005א\u0005ױ\u0005 \u0000ױ\u0005װ\u0005ג\u0005א\u0005ח\u0005ך\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000�\u0005ױ\u0005׳\u0005 \u0000�\u0005װ\u0005ׂ\u0005י\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׳\u0005�\u0005ױ\u0005�\u0005.\u0000 \u0000�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005 \u0000װ\u0005�\u0005ט\u0005װ\u0005 \u0000�\u0005ׂ\u0005א\u0005״\u0005,\u0000 \u0000װ\u0005�\u0005�\u0005י\u0005�\u0005�\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׃\u0005ט\u0005�\u0005 \u0000י\u0005�\u0005 \u0000�\u0005�\u0005�\u0005�\u0005.\u0000 \u0000�\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005ה\u0005װ\u0005 \u0000י\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005׀\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005ך\u0005װ\u0005,\u0000 \u0000�\u0005�\u0005�\u0005�\u0005 \u0000ג\u0005י\u0005ך\u0005װ\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005װ\u0005�\u0005�\u0005װ\u0005,\u0000 \u0000ך\u0005�\u0005�\u0005׃\u0005 \u0000׀\u0005�\u0005ה\u0005װ\u0005 \u0000י\u0005׀\u0005א\u0005�\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005׃\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005י\u0005�\u0005 \u0000י\u0005�\u0005װ\u0005.\u0000 \u0000�\u0005�\u0005�\u0005�\u0005 \u0000ה\u0005ױ\u0005ג\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ג\u0005�\u0005 \u0000װ\u0005ח\u0005װ\u0005�\u0005�\u0005װ\u0005,\u0000 \u0000װ\u0005ח\u0005�\u0005�\u0005״\u0005װ\u0005 \u0000װ\u0005�\u0005ױ\u0005ז\u0005�\u0005׳\u0005ך\u0005 \u0000י\u0005�\u0005 \u0000ך\u0005�\u0005�\u0005�\u0005׃\u0005�\u0005 \u0000װ\u0005�\u0005׳\u0005ײ\u0005ױ\u0005ט\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000׀\u0005א\u0005ױ\u0005 \u0000�\u0005׀\u0005׳\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005ז\u0005�\u0005׳\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000ׁ\u0005�\u0005י\u0005�\u0005 \u0000װ\u0005׃\u0005ט\u0005�\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ױ\u0005׳\u0005ׂ\u0005 \u0000׳\u0005א\u0005ױ\u0005�\u0005װ\u0005 \u0000י\u0005�\u0005׳\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000א\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005 \u0000ג\u0005�\u0005י\u0005�\u0005ױ\u0005 \u0000�\u0005׳\u0005�\u0005ױ\u0005ח\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005ײ\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005 \u0000׀\u0005ך\u0005 \u0000ׂ\u0005א\u0005״\u0005 \u0000�\u0005ה\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005ח\u0005י\u0005 \u0000�\u0005װ\u0005ך\u0005א\u0005ז\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ז\u0005ׁ\u0005�\u0005ג\u0005 \u0000ׁ\u0005�\u0005א\u0005ב\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005 \u0000י\u0005�\u0005׳\u0005ך\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ה\u0005װ\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ט\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׃\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005,\u0000 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005�\u0005ׁ\u0005�\u0005�\u0005�\u0005.\u0000\n\u0000\n\u0000ׂ\u0005א\u0005״\u0005 \u0000ה\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005,\u0000 \u0000ױ\u0005׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005,\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000ײ\u0005ח\u0005ױ\u0005ח\u0005�\u0005�\u0005 \u0000�\u0005�\u0005 \u0000ׂ\u0005�\u0005 \u0000�\u0005�\u0005.\u0000 \u0000׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000ט\u0005ײ\u0005ׁ\u0005ױ\u0005ײ\u0005ױ\u0005ׁ\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000ױ\u0005�\u0005ג\u0005�\u0005ױ\u0005׃\u0005 \u0000ה\u0005װ\u0005,\u0000 \u0000ױ\u0005׀\u0005ך\u0005װ\u0005 \u0000�\u0005׳\u0005׃\u0005 \u0000ג\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005א\u0005װ\u0005 \u0000ך\u0005׳\u0005�\u0005ח\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005.\u0000 \u0000ׂ\u0005א\u0005״\u0005,\u0000 \u0000׀\u0005ך\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005׀\u0005װ\u0005 \u0000י\u0005�\u0005ױ\u0005ך\u0005.\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000\n\u0000\n\u0000(\u0000׳\u0005�\u0005ױ\u0005ח\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005)\u0000.\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000י\u0005ׁ\u0005׀\u0005ך\u0005�\u0005.\u0000 \u0000י\u0005�\u0005׀\u0005 \u0000ך\u0005׳\u0005י\u0005ׁ\u0005ױ\u0005 \u0000י\u0005ׂ\u0005�\u0005 \u0000�\u0005ט\u0005ג\u0005�\u0005ׁ\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005�\u0005�\u0005 \u0000ה\u0005װ\u0005,\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000�\u0005ױ\u0005ײ\u0005�\u0005א\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005״\u0005�\u0005ױ\u0005 \u0000װ\u0005א\u0005ה\u0005�\u0005׀\u0005,\u0000 \u0000�\u0005י\u0005ך\u0005ױ\u0005ך\u0005 \u0000�\u0005י\u0005װ\u0005ױ\u0005,\u0000 \u0000�\u0005׀\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005י\u0005װ\u0005ױ\u0005 \u0000ױ\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005ח\u0005ױ\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000׀\u0005ך\u0005�\u0005�\u0005 \u0000ה\u0005װ\u0005 \u0000ׁ\u0005ח\u0005ט\u0005ױ\u0005ׁ\u0005 \u0000י\u0005ױ\u0005ׁ\u0005.\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005י\u0005�\u0005ׁ\u0005װ\u0005 \u0000א\u0005א\u0005ג\u0005�\u0005װ\u0005 \u0000ׁ\u0005י\u0005ג\u000