05ׁ\u0005 \u0000ױ\u0005װ\u0005ׂ\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ט\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005ױ\u0005ד\u0005 \u0000׃\u0005ט\u0005ג\u0005�\u0005\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000׀\u0005ׁ\u0005ט\u0005װ\u0005�\u0005 \u0000�\u0005�\u0005�\u0005׀\u0005�\u0005�\u0005\u0007\u0000\u0013 \u0007\u0000׳\u0005ׁ\u0005ט\u0005 \u0000�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005י\u0005ג\u0005ׁ\u0005ט\u0005\u0007\u0000\u0007\u0000\n\u0000\n\u0000<\u0000�\u0005א\u0005װ\u0005�\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000>\u0000\n\u0000�\u0005װ\u0005ױ\u0005׃\u0005�\u0005ך\u0005 \u0000ׂ\u0005�\u0005׃\u0005�\u0005�\u0005\n\u0000\n\u0000<\u0000ט\u0005�\u0005י\u0005ױ\u0005�\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005:\u0000>\u0000\n\u0000װ\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005׳\u0005�\u0005\n\u0000 \u0000<\u0000ׁ\u0005׳\u0005�\u0005ט\u0005ך\u0005 \u0000�\u0005ױ\u0005\"\u0000ט\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005>\u0000\n\u0000\n\u0000\n\u0000<\u0000�\u0005ױ\u0005\"\u0000ט\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005�\u0005ב\u0005׃\u0005ט\u0005ך\u0005 \u0000ז\u0005׳\u0005�\u0005 \u0000װ\u0005א\u0005ׂ\u0005ׁ\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ט\u0005ׁ\u0005ױ\u0005ך\u0005�\u0005,\u0000 \u0000ך\u0005ױ\u0005׃\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005װ\u0005�\u0005ך\u0005א\u0005װ\u0005.\u0000 \u0000װ\u0005�\u0005י\u0005�\u0005ׁ\u0005װ\u0005 \u0000א\u0005ה\u0005ך\u0005׳\u0005ך\u0005.\u0000 \u0000ט\u0005ׁ\u0005ױ\u0005ך\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005ט\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005-\u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000׀\u0005ך\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005׀\u0005ך\u0005 \u0000׳\u0005ׁ\u0005ט\u0005�\u0005 \u0000ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000װ\u0005׳\u0005�\u0005א\u0005ױ\u0005�\u0005,\u0000 \u0000װ\u0005ך\u0005ט\u0005ׁ\u0005ױ\u0005ך\u0005 \u0000ױ\u0005װ\u0005ב\u0005ה\u0005ױ\u0005ט\u0005״\u0005.\u0000 \u0000ׁ\u0005װ\u0005ך\u0005׀\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00001\u00000\u00006\u0000׀\u0005(\u00001\u0000)\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ך\u0005�\u0005ׁ\u0005׃\u0005 \u0000�\u0005װ\u0005ׁ\u0005�\u0005׀\u0005 \u0000ׁ\u0005ה\u0005א\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005�\u0005�\u0005ז\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005�\u0005ב\u0005׃\u0005ט\u0005ך\u0005 \u0000�\u0005ׁ\u0005׳\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ג\u0005ח\u0005ׁ\u0005 \u0000�\u0005ט\u0005ׂ\u0005�\u0005 \u0000�\u0005�\u0005װ\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005י\u0005ׁ\u0005-\u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005.\u0000 \u0000�\u0005׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ט\u0005ׂ\u0005�\u0005 \u0000ג\u0005ׁ\u0005ט\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005א\u0005�\u0005ב\u0005״\u0005ט\u0005�\u0005׀\u0005�\u0005�\u0005 \u0000ג\u0005י\u0005�\u0005ט\u0005.\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005ג\u0005י\u0005װ\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׃\u0005ט\u0005�\u0005ױ\u0005,\u0000 \u0000ׁ\u0005״\u0005ױ\u0005ׁ\u0005 \u0000״\u0005ג\u0005�\u0005 \u0000ױ\u0005ׁ\u0005ט\u0005ױ\u0005ׁ\u0005 \u0000י\u0005�\u0005�\u0005.\u0000 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005-\u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ׁ\u0005ט\u0005�\u0005.\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000�\u0005ױ\u0005י\u0005ׁ\u0005-\u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005ױ\u0005׀\u0005�\u0005 \u0000׀\u0005׃\u0005�\u0005י\u0005״\u0005�\u0005�\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005,\u0000 \u0000׀\u0005׃\u0005ױ\u0005א\u0005�\u0005 \u0000�\u0005ױ\u0005י\u0005ׁ\u0005-\u0000ט\u0005׀\u0005י\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005�\u0005ב\u0005׃\u0005ט\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005 \u0000י\u0005׳\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000�\u0005ג\u0005ח\u0005ׁ\u0005 \u0000�\u0005ט\u0005ׂ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ײ\u0005ח\u0005ױ\u0005ח\u0005 \u0000�\u0005י\u0005ױ\u0005�\u0005 \u0000�\u0005׳\u0005�\u0005׀\u0005ױ\u0005ך\u0005 \u0000א\u0005ױ\u0005ב\u0005ה\u0005ױ\u0005ך\u0005 \u0000�\u0005ג\u0005ׁ\u0005ט\u0005 \u0000�\u0005�\u0005װ\u0005 \u0000י\u0005׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005�\u0005�\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005ח\u0005ז\u0005ך\u0005 \u0000י\u0005ׁ\u0005׳\u0005ױ\u0005 \u0000י\u0005�\u0005 \u0000׀\u0005׃\u0005�\u0005 \u0000ׁ\u0005ה\u0005א\u0005�\u0005ױ\u0005.\u0000 \u0000ׂ\u0005�\u0005 \u0000װ\u0005ױ\u0005ײ\u0005�\u0005ט\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000װ\u0005ג\u0005ׁ\u0005ט\u0005 \u0000װ\u0005ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005 \u0000װ\u0005ג\u0005י\u0005�\u0005ט\u0005,\u0000 \u0000ױ\u0005ׂ\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ה\u0005�\u0005 \u0000׀\u0005�\u0005י\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005ג\u0005�\u0005׃\u0005,\u0000 \u0000�\u0005�\u0005�\u0005 \u0000י\u0005�\u0005�\u0005�\u0005ט\u0005 \u0000׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000ׁ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000װ\u0005ך\u0005�\u0005׀\u0005ׁ\u0005ױ\u0005�\u0005 \u0000װ\u0005ׁ\u0005ט\u0005�\u0005׀\u0005 \u0000�\u0005ג\u0005י\u0005�\u0005�\u0005װ\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005ך\u0005 \u0000ך\u0005�\u0005�\u0005׃\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005ױ\u0005.\u0000 \u0000�\u0005׀\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005,\u0000 \u0000�\u0005ג\u0005ח\u0005ׁ\u0005,\u0000 \u0000י\u0005ײ\u0005׀\u0005ך\u0005 \u0000װ\u0005װ\u0005ײ\u0005׃\u0005�\u0005א\u0005ױ\u0005ך\u0005,\u0000 \u0000ײ\u0005׀\u0005ך\u0005 \u0000װ\u0005ײ\u0005�\u0005ט\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005ױ\u0005�\u0005�\u0005׳\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005י\u0005�\u0005�\u0005ױ\u0005ׁ\u0005 \u0000װ\u0005א\u0005�\u0005ױ\u0005�\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000ב\u0005ה\u0005ט\u0005׀\u0005 \u0000�\u0005ב\u0005�\u0005ה\u0005׀\u0005.\u0000 \u0000�\u0005ז\u0005׃\u0005 \u0000׀\u0005׳\u0005׃\u0005,\u0000 \u0000ג\u0005ט\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׳\u0005�\u0005א\u0005ױ\u0005�\u0005,\u0000 \u0000ױ\u0005�\u0005�\u0005 \u0000װ\u0005א\u0005ױ\u0005י\u0005׀\u0005�\u0005�\u0005 \u0000װ\u0005ח\u0005י\u0005ױ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005ז\u0005׃\u0005 \u0000י\u0005א\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000�\u0005׀\u0005 \u0000א\u0005ׁ\u0005׳\u0005ט\u0005א\u0005ױ\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000�\u0005׃\u0005ׁ\u0005ט\u0005 \u0000�\u0005ה\u0005װ\u0005 \u0000ג\u0005�\u0005 \u0000א\u0005ױ\u0005י\u0005׀\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005׀\u0005 \u0000�\u0005ח\u0005׃\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005ײ\u0005׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005י\u0005�\u0005�\u0005ױ\u0005ׁ\u0005 \u0000װ\u0005א\u0005�\u0005ױ\u0005�\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005�\u0005�\u0005.\u0000 \u0000�\u0005י\u0005 \u0000ׂ\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005א\u0005ױ\u0005י\u0005׀\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ב\u0005ה\u0005ױ\u0005ט\u0005״\u0005,\u0000 \u0000י\u0005ׁ\u0005ג\u0005�\u0005א\u0005�\u0005 \u0000ׁ\u0005װ\u0005ג\u0005�\u0005׃\u0005ך\u0005ױ\u0005 \u0000ׁ\u0005ז\u0005ױ\u0005ט\u0005װ\u0005 \u0000װ\u0005א\u0005�\u0005ױ\u0005א\u0005װ\u0005,\u0000 \u0000׀\u0005ה\u0005י\u0005ט\u0005 \u0000ׂ\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000�\u0005ה\u0005ג\u0005ױ\u0005�\u0005 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000�\u0005״\u0005ױ\u0005ׁ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005י\u0005ׁ\u0005 \u0000ׁ\u0005ז\u0005�\u0005ױ\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ׁ\u0005״\u0005ױ\u0005׳\u0005 \u0000י\u0005ׂ\u0005�\u0005 \u0000׀\u0005ך\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000װ\u0005א\u0005װ\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005׳\u0005�\u0005א\u0005ױ\u0005�\u0005 \u0000װ\u0005ׂ\u0005�\u0005ג\u0005 \u0000�\u0005�\u0005׀\u0005�\u0005,\u0000 \u0000װ\u0005ז\u0005״\u0005ט\u0005ד\u0005 \u0000׀\u0005�\u0005�\u0005א\u0005ױ\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005ח\u0005 \u0000�\u0005׀\u0005׳\u0005�\u0005 \u0000�\u0005�\u0005 \u0000ׁ\u0005װ\u0005ז\u0005�\u0005׳\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005,\u0000 \u0000ׁ\u0005�\u0005ה\u0005ױ\u0005ד\u0005 \u0000�\u0005�\u0005�\u0005 \u0000י\u0005װ\u0005׳\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005׳\u0005ט\u0005ױ\u0005 \u0000ׁ\u0005�\u0005 \u0000ׁ\u0005ג\u0005ױ\u0005׃\u0005 \u0000׃\u0005ח\u0005װ\u0005 \u0000׀\u0005ױ\u0005 \u0000י\u0005ך\u0005�\u0005�\u0005�\u0005.\u0000 \u0000ׁ\u0005װ\u0005ז\u0005�\u0005׳\u0005װ\u0005 \u0000ט\u0005ׁ\u0005װ\u0005 \u0000ׁ\u0005ך\u0005ה\u0005ח\u0005�\u0005׃\u0005 \u0000װ\u0005׳\u0005י\u0005ױ\u0005ׁ\u0005 \u0000װ\u0005ײ\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000<\u0000�\u0005ױ\u0005\"\u0000ט\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000װ\u0005�\u0005ב\u0005׃\u0005ט\u0005ך\u0005 \u0000ז\u0005׳\u0005�\u0005 \u0000װ\u0005א\u0005ׂ\u0005ׁ\u0005�\u0005:\u0000>\u0000\n\u0000>\u0000\n\u0000ך\u0005ױ\u0005׃\u0005װ\u0005.\u0000 \u0000י\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000י\u0005ט\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005װ\u0005י\u0005ט\u0005 \u0000�\u0005ה\u0005�\u0005ך\u0005ױ\u0005׳\u0005 \u0000װ\u0005א\u0005ׂ\u0005ׁ\u0005 \u0000ױ\u0005װ\u0005ׂ\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ט\u0005�\u0005װ\u0005 \u0000�\u0005�\u0005�\u0005ױ\u0005ד\u0005 \u0000׃\u0005ט\u0005ג\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000�\u0005ׁ\u0005ױ\u0005׃\u0005 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0018\b\u0000\u0000\u001a\b\u0000\u0000 \b\u0000\u00000\b\u0000\u00002\b\u0000\u00006\b\u0000\u00008\b\u0000\u0000:\b\u0000\u0000T\b\u0000\u0000V\b\u0000\u0000X\b\u0000\u0000Z\b\u0000\u0000f\b\u0000\u0000�\b\u0000\u0000 \b\u0000\u0000\b \u0000\u0000\n \u0000\u0000 \u0000\u0000\u0010 \u0000\u0000\u0012 \u0000\u0000\" \u0000\u0000$ \u0000\u0000& \u0000\u0000( \u0000\u0000* \u0000\u0000קךגק׳ְֽ¬ק¢¬ְק˜ְ�€xֽb€UbֽG\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u001b\u0003j\u0000\u0000\u0000\u0000 *\u0007\u0016h�Q“\u0000<\b�U\b\u0001Z\b��*\u0001\u0018\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u00005\b�>*\u0001Z\b�\\\b�\u0000*\u0003j\u0000\u0000\u0000\u000