n\u0000ט\u0005ח\u0005 \u0000ט\u0005ז\u0005�\u0005ך\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000-\u0000 \u0000-\u0000 \u0000-\u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000׃\u0005ױ\u0005׃\u0005 \u0000ט\u0005ױ\u0005ך\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ׁ\u0005ױ\u0005׀\u0005 \u0000א\u0005׀\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005װ\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ב\u0005ך\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000ך\u0005ױ\u0005ז\u0005׀\u0005ױ\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005 \u0000׀\u0005׳\u0005�\u0005׃\u0005 \u0000״\u0005�\u0005ׁ\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005ז\u0005ׁ\u0005�\u0005ג\u0005 \u0000א\u0005ׂ\u0005׃\u0005 \u0000�\u0005י\u0005׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005ז\u0005ׁ\u0005�\u0005ג\u0005 \u0000ׁ\u0005ג\u0005׃\u0005 \u0000�\u0005י\u0005׀\u0005א\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ח\u0005ט\u0005�\u0005׀\u0005װ\u0005:\u0000>\u0000\n\u0000\n\u0000ײ\u0005ױ\u0005 \u0000װ\u0005ׂ\u0005�\u0005י\u0005װ\u0005 \u0000ׁ\u0005�\u0005ײ\u0005ט\u0005׳\u0005 \u0000װ\u0005ך\u0005�\u0005�\u0005ױ\u0005�\u0005.\u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000׃\u0005ױ\u0005׃\u0005 \u0000ט\u0005ױ\u0005ך\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000�\u0005�\u0005,\u0000 \u0000ׁ\u0005ױ\u0005׀\u0005 \u0000א\u0005׀\u0005�\u0005ט\u0005 \u0000�\u0005�\u0005װ\u0005.\u0000\n\u0000 \u0000\n\u0000<\u0000׀\u0005ױ\u0005ט\u0005�\u0005 \u0000�\u0005ח\u0005�\u0005ׁ\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005ײ\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005ױ\u0005ׂ\u0005׃\u0005ט\u0005?\u0000 \u0000ײ\u0005װ\u0005 \u0000�\u0005ױ\u0005ׂ\u0005׃\u0005ט\u0005 \u0000�\u0005א\u0005�\u0005א\u0005ג\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005�