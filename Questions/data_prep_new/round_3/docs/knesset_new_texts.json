 \u0007\u0000�\u0005ט\u0005�\u0005ײ\u0005 \u0000װ\u0005�\u0005׳\u0005ח\u0005ט\u0005 \u0000ױ\u0005װ\u0005�\u0005�\u0005׃\u0005ג\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005 \u0000\u0007\u0000\u0007\u0000\n\u0000\n\u0000<\u0000�\u0005�\u0005ג\u0005ױ\u0005ו\u0005 \u0000�\u0005י\u0005ה\u0005״\u0005�\u0005:\u0000 \u0000>\u0000\n\u0000׀\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005 \u0000׀\u0005ט\u0005�\u0005\n\u0000\n\u0000<\u0000ט\u0005׀\u0005י\u0005 \u0000ך\u0005׳\u0005ױ\u0005�\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005 \u0000ׁ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000>\u0000\n\u0000׀\u0005ך\u0005�\u0005 \u0000י\u0005ׁ\u0005ך\u0005׀\u0005�\u0005\n\u0000\n\u0000<\u0000ט\u0005�\u0005י\u0005ױ\u0005�\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005:\u0000>\u0000\n\u0000׀\u0005�\u0005ט\u0005�\u0005ך\u0005 \u0000י\u0005�\u0005װ\u0005ׁ\u0005ך\u0005\n\u0000 \u0000<\u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005װ\u0005ך\u0005ׂ\u0005ױ\u0005א\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005ײ\u0005ט\u0005׳\u0005�\u0005ך\u0005 \u0000(\u0000�\u0005ה\u0005ט\u0005״\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005א\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005�\u0005�\u0005)\u0000 \u0000(\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ג\u0005\"\u0000ױ\u0005-\u00002\u00000\u00001\u00005\u0000>\u0000\n\u0000\n\u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000׀\u0005�\u0005�\u0005�\u0005 \u0000ׂ\u0005�\u0005�\u0005׀\u0005ױ\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ׁ\u0005ט\u0005ױ\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005ׁ\u0005׀\u0005�\u0005�\u0005.\u0000 \u0000׀\u0005א\u0005׳\u0005א\u0005ױ\u0005 \u0000׃\u0005א\u0005�\u0005�\u0005 \u0000ׁ\u0005׳\u0005�\u0005ח\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005�\u0005\"\u0000׃\u0005�\u0005�\u0005.\u0000 \u0000װ\u0005ט\u0005ׁ\u0005װ\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005 \u0000ײ\u0005�\u0005�\u0005 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005׳\u0005�\u0005װ\u0005 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005 \u0000ױ\u0005װ\u0005�\u0005ױ\u0005�\u0005 \u0000א\u0005ב\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005.\u0000 \u0000�\u0005׀\u0005 \u0000ח\u0005�\u0005ׁ\u0005�\u0005ך\u0005�\u0005 \u0000װ\u0005ך\u0005א\u0005ׂ\u0005׃\u0005ױ\u0005�\u0005ױ\u0005ך\u0005.\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ׁ\u0005�\u0005�\u0005 \u0000י\u0005װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000א\u0005�\u0005׃\u0005ױ\u0005א\u0005ױ\u0005 \u0000ב\u0005ׁ\u0005�\u0005ׁ\u0005 \u0000י\u0005ױ\u0005�\u0005׳\u0005�\u0005 \u0000ג\u0005ׂ\u0005ױ\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ה\u0005י\u0005ט\u0005 \u0000�\u0005ׂ\u0005י\u0005ך\u0005 \u0000�\u0005�\u0005י\u0005 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005,\u0000 \u0000�\u0005׀\u0005י\u0005ט\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005 \u0000ױ\u0005�\u0005װ\u0005�\u0005י\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005׀\u0005װ\u0005.\u0000 \u0000׀\u0005ׁ\u0005ח\u0005י\u0005 \u0000י\u0005׀\u0005ך\u0005�\u0005 \u0000ך\u0005ז\u0005�\u0005ׂ\u0005ױ\u0005 \u0000׀\u0005ך\u0005 \u0000ג\u0005ז\u0005�\u0005�\u0005�\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000׳\u0005�\u0005 \u0000י\u0005�\u0005�\u0005ױ\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005�\u0005ג\u0005ױ\u0005ו\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005 \u0000ׁ\u0005ה\u0005�\u0005ח\u0005ױ\u0005׃\u0005 \u0000װ\u0005ג\u0005ױ\u0005ט\u0005ד\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000ז\u0005'\u0000�\u0005ז\u0005�\u0005׀\u0005ױ\u0005 \u0000א\u0005׃\u0005׀\u0005ױ\u0005:\u0000>\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000ט\u0005׀\u0005י\u0005 \u0000�\u0005׃\u0005ױ\u0005ט\u0005 \u0000װ\u0005א\u0005׃\u0005ב\u0005ך\u0005 \u0000�\u0005�\u0005ׂ\u0005ױ\u0005�\u0005 \u0000ױ\u0005׳\u0005�\u0005�\u0005ױ\u0005ו\u0005 \u0000ׁ\u0005ה\u0005�\u0005ח\u0005ױ\u0005׃\u0005 \u0000װ\u0005ג\u0005ױ\u0005ט\u0005ד\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000׀\u0005�\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005 \u0000׀\u0005ט\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000װ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005ױ\u0005א\u0005׳\u0005ױ\u0005ך\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005,\u0000 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000׀\u0005�\u0005י\u0005ט\u0005װ\u0005 \u0000׀\u0005ױ\u0005ך\u0005�\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ח\u0005״\u0005ױ\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005י\u0005א\u0005װ\u0005 \u0000י\u0005ג\u0005ׁ\u0005ט\u0005װ\u0005,\u0000 \u0000׀\u0005ׁ\u0005�\u0005 \u0000�\u0005�\u0005�\u0005ױ\u0005ױ\u0005�\u0005 \u0000י\u0005װ\u0005ױ\u0005״\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005ה\u0005א\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005ג\u0005 \u0000�\u0005ך\u0005ט\u0005י\u0005�\u0005�\u0005 \u0000�\u0005ױ\u0005ב\u0005�\u0005�\u0005 \u0000ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000י\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000א\u0005׳\u0005ך\u0005�\u0005ױ\u0005 \u0000�\u0005�\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005׳\u0005�\u0005ט\u0005ױ\u0005ך\u0005.\u0000 \u0000װ\u0005ך\u0005ט\u0005י\u0005�\u0005�\u0005 \u0000װ\u0005ׂ\u0005�\u0005ג\u0005 \u0000�\u0005ׁ\u0005ט\u0005 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000װ\u0005ׁ\u0005׳\u0005�\u0005ט\u0005ױ\u0005ך\u0005,\u0000 \u0000�\u0005�\u0005�\u0005 \u0000א\u0005׀\u0005�\u0005ז\u0005ױ\u0005 \u0000�\u0005װ\u0005ׂ\u0005�\u0005י\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005 \u0000�\u0005׳\u0005׃\u0005י\u0005.\u0000 \u0000\n\u0000\n\u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005װ\u0005ך\u0005ׂ\u0005ױ\u0005א\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005ײ\u0005ט\u0005׳\u0005�\u0005ך\u0005 \u0000(\u0000�\u0005ה\u0005ט\u0005״\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005א\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005�\u0005�\u0005)\u0000(\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ג\u0005\"\u0000ױ\u0005\u0013 2\u00000\u00001\u00005\u0000\n\u0000\n\u0000\"\u0000ׁ\u0005ך\u0005ױ\u0005ח\u0005ד\u0005 \u0000ב\u0005�\u0005�\u0005ױ\u0005ך\u0005�\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000ב\u0005ג\u0005�\u0005ה\u0005�\u0005�\u0005 \u00001\u00004\u0000׃\u0005 \u0000ױ\u0005-\u00002\u00007\u0000 \u0000�\u0005׳\u0005ױ\u0005ח\u0005 \u0000װ\u0005װ\u0005ך\u0005ׂ\u0005ױ\u0005א\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005ײ\u0005ט\u0005׳\u0005�\u0005ך\u0005,\u0000 \u0000װ\u0005ך\u0005י\u0005�\u0005\"\u0000׀\u0005\u0013 1\u00009\u00005\u00001\u0000,\u0000 \u0000�\u0005׀\u0005׳\u0005ט\u0005 \u0000װ\u0005ך\u0005�\u0005�\u0005ג\u0005ז\u0005ױ\u0005ך\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005ה\u0005א\u0005�\u0005�\u0005,\u0000 \u0000ג\u0005�\u0005 \u0000װ\u0005א\u0005ז\u0005�\u0005ׁ\u0005ױ\u0005ך\u0005 \u0000ױ\u0005ג\u0005�\u0005 \u0000׀\u0005ט\u0005ׂ\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000װ\u0005ג\u0005ױ\u0005ב\u0005ח\u0005�\u0005�\u0005 \u0000ׁ\u0005ח\u0005�\u0005׃\u0005ױ\u0005�\u0005 \u0000ײ\u0005�\u0005ױ\u0005�\u0005ױ\u0005ך\u0005�\u0005װ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000׀\u0005א\u0005י\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005װ\u0005ב\u0005�\u0005�\u0005ך\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005׀\u0005ױ\u0005ז\u0005ט\u0005 \u0000ױ\u0005ׁ\u0005׀\u0005�\u0005י\u0005ױ\u0005ט\u0005 \u0000ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000װ\u0005ג\u0005ׁ\u0005ױ\u0005׃\u0005װ\u0005 \u0000װ\u0005ט\u0005ױ\u0005ױ\u0005׳\u0005װ\u0005 \u0000ױ\u0005װ\u0005ׁ\u0005ט\u0005�\u0005׀\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005�\u0005א\u0005ב\u0005ך\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ך\u0005ח\u0005�\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000׀\u0005�\u0005װ\u0005:\u0000\n\u0000\n\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u0000\u0007\u00001\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005װ\u0005ך\u0005ׂ\u0005ױ\u0005א\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005׀\u0005ײ\u0005ט\u0005׳\u0005�\u0005ך\u0005 \u0000(\u0000�\u0005ה\u0005ט\u0005״\u0005�\u0005�\u0005 \u0000�\u0005ׁ\u0005א\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005�\u0005�\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005\"\u0000�\u0005\u0013 1\u00009\u00009\u00000\u0000 \u0000(\u0000�\u0005װ\u0005�\u0005�\u0005 \u0000\u0013 \u0000װ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005)\u0000 \u0000\u0013 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000װ\u0005װ\u0005ׂ\u0005׃\u0005ט\u0005װ\u0005 \u0000\"\u0000\"\u0000׳\u0005�\u0005ױ\u0005�\u0005 \u0000װ\u0005׃\u0005ד\u0005 \u0000ױ\u0005ט\u0005ב\u0005�\u0005ב\u0005�\u0005�\u0005\"\u0000\"\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000\"\u0000׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000\"\u0000 \u0000\u0013 \u0000׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000 \u0000ׁ\u0005ך\u0005ױ\u0005ב\u0005ה\u0005ך\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005�\u0005א\u0005ױ\u0005�\u0005;\u0000\"\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00003\u0000\u0007\u00002\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00003\u0000(\u0000׀\u0005)\u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000\"\u00001\u00001\u0000%\u0000\"\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000װ\u0005ח\u0005ׁ\u0005ױ\u0005ג\u0005 \u0000ׁ\u0005ה\u0005ט\u0005״\u0005�\u0005�\u0005 \u00008\u0000.\u00005\u00004\u0000(\u00001\u0000)\u0000 \u0000׀\u0005ױ\u0005 \u0000(\u00004\u0000)\u0000 \u0000ױ\u0005-\u00008\u0000.\u00006\u00000\u0000 \u0000�\u0005׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000 \u0000�\u0005ה\u0005�\u0005 \u0000װ\u0005ג\u0005א\u0005�\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005׀\u0005 \u0000׀\u0005�\u0005 \u0000�\u0005�\u0005 \u0000א\u0005ח\u0005ׁ\u0005ג\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000׀\u0005ױ\u0005 \u0000׃\u0005ט\u0005�\u0005י\u0005װ\u0005 \u0000�\u0005ױ\u0005ה\u0005׳\u0005ך\u0005ך\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005.\u0000\"\u0000.\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00005\u0000\u0007\u00003\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00005\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000װ\u0005)\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000װ\u0005)\u0000 \u0000ג\u0005�\u0005 \u0000ט\u0005ױ\u0005׳\u0005ׁ\u0005 \u0000׃\u0005ט\u0005�\u0005 \u0000װ\u0005ׂ\u0005�\u0005י\u0005װ\u0005 \u0000ׁ\u0005ב\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005 \u0000�\u0005׳\u0005ױ\u0005�\u0005ױ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ה\u0005ט\u0005״\u0005 \u00008\u0000.\u00005\u00008\u0000 \u0000�\u0005׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000,\u0000 \u0000׀\u0005�\u0005 \u0000ׁ\u0005�\u0005ח\u0005�\u0005״\u0005 \u0000�\u0005ב\u0005ױ\u0005ׂ\u0005 \u0000׀\u0005-\u00001\u0000,\u0000 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000י\u0005ט\u0005ױ\u0005׳\u0005ׁ\u0005 \u0000׃\u0005ט\u0005�\u0005 \u0000װ\u0005ׂ\u0005�\u0005י\u0005װ\u0005 \u0000׀\u0005ױ\u0005 \u0000׃\u0005ט\u0005�\u0005 \u0000ה\u0005א\u0005�\u0005�\u0005�\u0005ך\u0005 \u0000ׁ\u0005׀\u0005ײ\u0005ױ\u0005ט\u0005 \u0000װ\u0005ב\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005�\u0005א\u0005�\u0005ב\u0005װ\u0005 \u0000װ\u0005�\u0005ױ\u0005ׂ\u0005א\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005�\u0005א\u0005�\u0005ב\u0005װ\u0005 \u0000ה\u0005א\u0005�\u0005�\u0005�\u0005ך\u0005 \u0000�\u0005ױ\u0005ׂ\u0005א\u0005ך\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000ח\u0005״\u0005�\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005,\u0000 \u0000ױ\u0005ׁ\u0005�\u0005ׁ\u0005׃\u0005 \u0000י\u0005�\u0005׀\u0005ה\u0005י\u0005ט\u0005 \u0000׀\u0005ך\u0005 \u0000ה\u0005ך\u0005�\u0005׳\u0005ך\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005׃\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005ײ\u0005ג\u0005ט\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005װ\u0005ך\u0005ח\u0005א\u0005ך\u0005 \u0000׃\u0005�\u0005ך\u0005ױ\u0005ך\u0005 \u0000ױ\u0005׳\u0005�\u0005ױ\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005ה\u0005ױ\u0005ט\u0005״\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005׳\u0005�\u0005ח\u0005 \u0000ׁ\u0005'\u0000 \u0000ׁ\u0005ך\u0005ױ\u0005ב\u0005ה\u0005ך\u0005 \u0000װ\u0005ט\u0005׀\u0005י\u0005ױ\u0005א\u0005װ\u0005.\u0000\"\u0000 \u0000\u0007\u0000\u0007\u0000ׁ\u0005�\u0005״\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00006\u0000\u0007\u00004\u0000.\u0000\u0007\u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00006\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005 \u0000\u0013 \u0000ׁ\u0005״\u0005�\u0005װ\u0005.\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00003\u00004\u0000\u0007\u00005\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00003\u00004\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000׃\u0005)\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000׃\u0005)\u0000 \u0000ׁ\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005,\u0000 \u0000�\u0005�\u0005ג\u0005״\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005 \u0000�\u0005ב\u0005ױ\u0005ׂ\u0005 \u0000׀\u0005-\u00001\u0000,\u0000 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005ה\u0005�\u0005ב\u0005 \u0000ב\u0005ד\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005 \u0000ׁ\u0005ׂ\u0005ױ\u0005ׁ\u0005װ\u0005 \u00006\u0000 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000װ\u0005׳\u0005�\u0005ה\u0005ױ\u0005�\u0005 \u0000װ\u0005ב\u0005ױ\u0005ה\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000ׁ\u0005ז\u0005׃\u0005 \u0000י\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005ױ\u0005�\u0005 \u0000ה\u0005ך\u0005�\u0005׳\u0005ך\u0005 \u0000װ\u0005׃\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000ך\u0005ױ\u0005ך\u0005ט\u0005 \u0000ב\u0005״\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ט\u0005ׁ\u0005�\u0005ך\u0005 \u0000י\u0005�\u0005 \u0000׳\u0005ז\u0005�\u0005 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005 \u0000�\u0005�\u0005ה\u0005�\u0005 \u0000�\u0005ג\u0005�\u0005װ\u0005;\u0000 \u0000ׁ\u0005ז\u0005�\u0005׃\u0005ױ\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005 \u0000י\u0005�\u0005 \u0000�\u0005ה\u0005ך\u0005�\u0005 \u0000װ\u0005׃\u0005�\u0005ך\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005ה\u0005�\u0005ב\u0005 \u0000ה\u0005א\u0005�\u0005 \u0000װ\u0005׳\u0005�\u0005ה\u0005ױ\u0005�\u0005 \u0000װ\u0005ב\u0005ױ\u0005ה\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000ׁ\u0005�\u0005ה\u0005�\u0005ב\u0005 \u0000ב\u0005ד\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005.\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000(\u0000׃\u00051\u0000)\u0000 \u0000 \u0000 \u0000 \u0000 \u0000�\u0005׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005 \u0000�\u0005ױ\u0005ך\u0005ח\u0005�\u0005 \u0000ב\u0005ד\u0005 \u0000ה\u0005ט\u0005�\u0005ח\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005ך\u0005ח\u0005ה\u0005�\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000׃\u0005ט\u0005�\u0005י\u0005ױ\u0005ך\u0005 \u0000ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00003\u0000.\u00001\u0000,\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u0000.\u00002\u0000.\u00004\u0000 \u0000װ\u0005׃\u0005�\u0005 \u0000ׁ\u0005ב\u0005ד\u0005 \u0000י\u0005ׂ\u0005ױ\u0005ׁ\u0005װ\u0005ױ\u0005 \u0000ג\u0005׃\u0005 \u00006\u0000 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005�\u0005�\u0005;\u0000 \u0000װ\u0005ב\u0005ד\u0005 \u0000װ\u0005ה\u0005ט\u0005�\u0005ח\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000ׁ\u0005א\u0005�\u0005ׂ\u0005ױ\u0005׃\u0005 \u0000׳\u0005ײ\u0005ױ\u0005ך\u0005�\u0005 \u0000�\u0005ׂ\u0005ױ\u0005ױ\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005׃\u0005ױ\u0005;\u0000 \u0000�\u0005ג\u0005א\u0005�\u0005�\u0005�\u0005 \u0000ײ\u0005װ\u0005,\u0000 \u0000\"\u0000א\u0005�\u0005ׂ\u0005ױ\u0005׃\u0005 \u0000׳\u0005ײ\u0005ױ\u0005ך\u0005�\u0005\"\u0000 \u0000\u0013 \u0000�\u0005װ\u0005ׂ\u0005׃\u0005ט\u0005ך\u0005ױ\u0005 \u0000ׁ\u0005ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00006\u0000 \u0000א\u0005ׂ\u0005�\u0005י\u0005ױ\u0005ך\u0005 \u0000װ\u0005ב\u0005ׁ\u0005�\u0005ׁ\u0005װ\u0005 \u0000װ\u0005ׁ\u0005א\u0005ױ\u0005�\u0005װ\u0005:\u0000 \u0000׀\u0005�\u0005ז\u0005ג\u0005�\u0005 \u0000׀\u0005ײ\u0005װ\u0005ט\u0005װ\u0005 \u0000ױ\u0005װ\u0005�\u0005ױ\u0005ױ\u0005א\u0005װ\u0005 \u0000�\u0005׀\u0005א\u0005י\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005ױ\u0005ך\u0005 \u0000ט\u0005׀\u0005�\u0005�\u0005װ\u0005.\u0000\"\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00005\u00000\u0000\u0007\u00006\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00005\u00000\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000ׂ\u0005)\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000ׂ\u0005)\u0000 \u0000ׁ\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005,\u0000 \u0000�\u0005�\u0005ג\u0005״\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005 \u0000�\u0005ב\u0005ױ\u0005ׂ\u0005 \u0000׀\u0005-\u00001\u0000,\u0000 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005ה\u0005�\u0005ב\u0005 \u0000ב\u0005ד\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005ׂ\u0005ײ\u0005 \u0000 \u0000ׁ\u0005ׂ\u0005ױ\u0005ׁ\u0005װ\u0005 \u00006\u0000 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000װ\u0005׳\u0005�\u0005ה\u0005ױ\u0005�\u0005 \u0000װ\u0005ב\u0005ױ\u0005ה\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000ׁ\u0005ז\u0005׃\u0005 \u0000י\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005ױ\u0005�\u0005 \u0000ה\u0005ך\u0005�\u0005׳\u0005ך\u0005 \u0000װ\u0005׃\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000ך\u0005ױ\u0005ך\u0005ט\u0005 \u0000ב\u0005״\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005ט\u0005ׁ\u0005�\u0005ך\u0005 \u0000י\u0005�\u0005 \u0000׳\u0005ז\u0005�\u0005 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005 \u0000�\u0005�\u0005ה\u0005�\u0005 \u0000�\u0005ג\u0005�\u0005װ\u0005;\u0000 \u0000ׁ\u0005ז\u0005�\u0005׃\u0005ױ\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005 \u0000י\u0005�\u0005 \u0000�\u0005ה\u0005ך\u0005�\u0005 \u0000װ\u0005׃\u0005�\u0005ך\u0005 \u0000�\u0005ה\u0005�\u0005ב\u0005 \u0000ה\u0005א\u0005�\u0005 \u0000װ\u0005׳\u0005�\u0005ה\u0005ױ\u0005�\u0005 \u0000װ\u0005ב\u0005ױ\u0005ה\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000ׁ\u0005�\u0005ה\u0005�\u0005ב\u0005 \u0000ב\u0005ד\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005ׂ\u0005ײ\u0005.\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000(\u0000ׂ\u00051\u0000)\u0000 \u0000 \u0000 \u0000 \u0000 \u0000�\u0005׃\u0005�\u0005ך\u0005 \u0000װ\u0005ׂ\u0005ײ\u0005 \u0000�\u0005ױ\u0005ך\u0005ח\u0005�\u0005 \u0000ב\u0005ד\u0005 \u0000ה\u0005ט\u0005�\u0005ח\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005ך\u0005ח\u0005ה\u0005�\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000׃\u0005ט\u0005�\u0005י\u0005ױ\u0005ך\u0005 \u0000ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00003\u0000.\u00001\u0000,\u0000 \u0000ׁ\u0005ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u0000.\u00002\u0000.\u00004\u0000 \u0000װ\u0005׃\u0005�\u0005 \u0000ׁ\u0005ב\u0005ד\u0005 \u0000י\u0005ׂ\u0005ױ\u0005ׁ\u0005װ\u0005ױ\u0005 \u0000ג\u0005׃\u0005 \u00006\u0000 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005�\u0005�\u0005;\u0000 \u0000װ\u0005ב\u0005ד\u0005 \u0000װ\u0005ה\u0005ט\u0005�\u0005ח\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000ׁ\u0005א\u0005�\u0005ׂ\u0005ױ\u0005׃\u0005 \u0000׳\u0005ײ\u0005ױ\u0005ך\u0005�\u0005 \u0000�\u0005ׂ\u0005ױ\u0005ױ\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005 \u0000י\u0005�\u0005�\u0005׃\u0005ױ\u0005.\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00000\u00005\u0000\u0007\u00007\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u0000 \u00001\u00000\u00005\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000׀\u0005)\u0000 \u0000ׁ\u0005ט\u0005׀\u0005י\u0005װ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000ׁ\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005,\u0000 \u0000�\u0005�\u0005ג\u0005״\u0005 \u0000�\u0005ח\u0005�\u0005״\u0005 \u0000�\u0005ב\u0005ױ\u0005ׂ\u0005 \u0000 \u0000׀\u0005-\u00001\u0000,\u0000 \u0000�\u0005ױ\u0005ך\u0005ח\u0005�\u0005 \u0000�\u0005ה\u0005׳\u0005ױ\u0005ך\u0005 \u0000ך\u0005׀\u0005 \u0000ׁ\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ב\u0005׀\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000א\u0005ׂ\u0005�\u0005י\u0005 \u0000י\u0005�\u0005ך\u0005ח\u0005�\u0005�\u0005�\u0005ױ\u0005 \u0000ׁ\u0005ױ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u0000.\u00001\u00001\u0000 \u0000ׁ\u0005ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00003\u0000.\u00001\u0000;\u0000\"\u0000 \u0000ױ\u0005׀\u0005׳\u0005ט\u0005�\u0005 \u0000\"\u0000�\u0005�\u0005 \u0000ך\u0005׀\u0005 \u0000ׁ\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ב\u0005׀\u0005\"\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000א\u0005ױ\u0005ב\u0005ד\u0005 \u0000י\u0005׀\u0005�\u0005א\u0005ױ\u0005 \u0000ך\u0005׀\u0005 \u0000ׁ\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ב\u0005׀\u0005 \u0000א\u0005ׂ\u0005�\u0005י\u0005\"\u0000.\u0000 \u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00001\u00006\u0000\u0007\u00008\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00001\u00006\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000׀\u0005)\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000׀\u00051\u0000)\u0000 \u0000׀\u0005׳\u0005׃\u0005 \u0000װ\u0005�\u0005�\u0005ױ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000א\u0005ׂ\u0005�\u0005י\u0005 \u0000�\u0005׀\u0005׃\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005ױ\u0005ך\u0005 \u0000ױ\u0005�\u0005ך\u0005ח\u0005�\u0005�\u0005�\u0005ױ\u0005 \u0000ׁ\u0005ױ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u0000.\u00001\u00001\u0000.\u00007\u0000.\u00002\u0000 \u0000ׁ\u0005ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00003\u0000.\u00001\u0000 \u0000ױ\u0005�\u0005׃\u0005�\u0005ך\u0005 \u0000װ\u0005ׁ\u0005ט\u0005ײ\u0005 \u0000ך\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005ב\u0005ױ\u0005ׂ\u0005 \u0000�\u0005א\u0005ױ\u0005ד\u0005.\u0000\"\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00002\u00004\u0000\u0007\u00009\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00002\u00004\u0000(\u0000׀\u0005)\u0000(\u00003\u0000)\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005 \u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000\"\u0000י\u0005�\u0005׀\u0005 \u0000�\u0005ה\u0005׳\u0005ך\u0005 \u0000�\u0005-\u00001\u0000.\u00004\u00000\u0000 \u0000�\u0005״\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005 \u0000װ\u0005ט\u0005ז\u0005ה\u0005װ\u0005\"\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000�\u0005ה\u0005�\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ה\u0005ט\u0005״\u0005 \u00008\u0000.\u00002\u00002\u00002\u0000 \u0000�\u0005׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000\"\u0000.\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00005\u00009\u0000\u0007\u00001\u00000\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00005\u00009\u0000(\u0000װ\u0005)\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000װ\u0005ב\u0005�\u0005ה\u0005װ\u0005 \u0000װ\u0005�\u0005ך\u0005׳\u0005�\u0005�\u0005װ\u0005 \u0000ׁ\u0005\"\u0000ך\u0005ױ\u0005ך\u0005ח\u0005�\u0005 \u0000�\u0005י\u0005ג\u0005א\u0005ך\u0005 \u0000�\u0005׃\u0005\"\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000�\u0005ױ\u0005ך\u0005ח\u0005א\u0005ױ\u0005 \u0000ׁ\u0005ך\u0005�\u0005 \u0000׀\u0005׳\u0005�\u0005ײ\u0005װ\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000ה\u0005ט\u0005״\u0005�\u0005�\u0005 \u00003\u0000.\u00002\u0000.\u00002\u0000.\u00001\u00006\u0000,\u0000 \u00003\u0000.\u00002\u0000.\u00002\u0000.\u00001\u00007\u0000,\u0000 \u00003\u0000.\u00002\u0000.\u00003\u0000.\u00001\u0000(\u0000װ\u0005)\u0000 \u0000ױ\u0005-\u00008\u0000.\u00001\u00003\u00000\u0000 \u0000�\u0005ך\u0005ױ\u0005ב\u0005ה\u0005ך\u0005 \u0000װ\u0005י\u0005א\u0005�\u0005װ\u0005 \u0000ׁ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005�\u0005א\u0005ױ\u0005�\u0005\"\u0000.\u0000 \u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00007\u00007\u0000\u0007\u00001\u00001\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00007\u00007\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000ׁ\u0005ב\u0005ױ\u0005ה\u0005װ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\"\u0000ױ\u0005�\u0005׳\u0005ױ\u0005�\u0005ױ\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ה\u0005ט\u0005״\u0005 \u00008\u0000.\u00005\u00008\u0000 \u0000�\u0005׳\u0005�\u0005ח\u0005 \u0000׳\u0005'\u00001\u0000,\u0000 \u0000ׁ\u0005י\u0005�\u0005א\u0005ױ\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005׳\u0005ױ\u0005�\u0005ׁ\u0005�\u0005�\u0005\"\u0000.\u0000 \u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00008\u00008\u0000\u0007\u00001\u00002\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u00008\u00008\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000׀\u0005)\u0000 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005:\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000׀\u00051\u0000)\u0000 \u0000ׁ\u0005ׁ\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ב\u0005׀\u0005 \u0000�\u0005�\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005 \u0000׀\u0005׳\u0005ט\u0005,\u0000 \u0000�\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005ך\u0005ח\u0005א\u0005ך\u0005 \u0000�\u0005י\u0005א\u0005װ\u0005 \u0000(\u0000׀\u0005)\u0000,\u0000 \u0000י\u0005ׁ\u0005�\u0005ט\u0005׳\u0005ׁ\u0005 \u0000�\u0005ױ\u0005ׂ\u0005�\u0005 \u0000�\u0005ױ\u0005ב\u0005׃\u0005�\u0005 \u0000ױ\u0005ׁ\u0005�\u0005ט\u0005׳\u0005ׁ\u0005 \u0000�\u0005ױ\u0005ׂ\u0005�\u0005 \u0000י\u0005ׁ\u0005�\u0005ױ\u0005ב\u0005׃\u0005 \u0000׳\u0005�\u0005א\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005ױ\u0005ך\u0005ח\u0005�\u0005 \u0000�\u0005׀\u0005׳\u0005ײ\u0005 \u0000�\u0005׃\u0005 \u0000ח\u0005ׁ\u0005ױ\u0005ג\u0005 \u0000׀\u0005׳\u0005׃\u0005 \u0000�\u0005ה\u0005׳\u0005ױ\u0005ך\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000װ\u0005ױ\u0005ט\u0005׀\u0005ױ\u0005ך\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u00002\u0000.\u00001\u00001\u0000.\u00006\u0000 \u0000ׁ\u0005ך\u0005\"\u0000�\u0005 \u00001\u00009\u00001\u00008\u0000 \u0000׳\u0005�\u0005ח\u0005 \u00003\u0000.\u00001\u0000.\u0000\"\u0000\u0007\u0000\u0007\u0000ך\u0005�\u0005ח\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00000\u00002\u0000\u0007\u00001\u00003\u0000.\u0000\u0007\u0000ׁ\u0005ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u00000\u00002\u0000 \u0000�\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ג\u0005�\u0005ח\u0005ט\u0005�\u0005ױ\u0005ך\u0005,\u0000 \u0000װ\u0005׀\u0005�\u0005ױ\u0005ט\u0005 \u0000ׁ\u0005װ\u0005 \u0000�\u0005ב\u0005ױ\u0005�\u0005�\u0005 \u0000(\u0000׀\u0005)\u0000,\u0000 \u0000ױ\u0005׀\u0005׳\u0005ט\u0005�\u0005ױ\u0005 \u0000�\u0005ׁ\u0005ױ\u0005׀\u0005 \u0000\u0013 \u0000\u0007\u0000\u0007\u0000\u0007\u0000\u0007\u0000\"\u0000(\u0000ׁ\u0005)\u0000 \u0000�\u0005ח\u0005ױ\u0005�\u0005 \u0000י\u0005ׁ\u0005ױ\u0005 \u0000�\u0005ױ\u0005�\u0005 \u0000׃\u0005�\u0005ך\u0005 \u0000װ\u0005װ\u0005׃\u0005ד\u0005 \u0000װ\u0005׃\u0005�\u0005ט\u0005ך\u0005�\u0005ך\u0005 \u0000�\u0005ז\u0005ױ\u0005�\u0005 \u0000ח\u0005�\u0005ט\u0005 \u0000װ\u0005�\u0005װ\u0005ױ\u0005ױ\u0005װ\u0005 \u0000׳\u0005�\u0005ח\u0005 \u0000�\u0005װ\u0005י\u0005�\u0005׃\u0005 \u0000׀\u0005ױ\u0005 \u0000ח\u0005�\u0005ט\u0005 \u0000װ\u0005ג\u0005י\u0005ױ\u0005�\u0005 \u0000ׁ\u0005״\u0005ױ\u0005�\u0005 \u0000�\u0005ײ\u0005ױ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005�\u0005ױ\u0005ח\u0005�\u0005 \u0000װ\u0005ח\u0005�\u0005ט\u0005 \u0000ׁ\u0005�\u0005ט\u0005׳\u0005ח\u0005 \u0000י\u0005�\u0005 \u00001\u00001\u00000\u0000 \u0000ב\u0005א\u0005״\u0005�\u0005�\u0005״\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005׳\u0005ױ\u0005ך\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005ך\u0005,\u0000 \u0000ױ\u0005ׁ\u0005װ\u0005ך\u0005׀\u0005�\u0005 \u0000�\u0005י\u0005ט\u0005״\u0005ױ\u0005״\u0005 \u0000י\u0005ׁ\u0005ך\u0005ױ\u0005ב\u0005ה\u0005ך\u0005 \u0000װ\u0005י\u0005�\u0005�\u0005א\u0005�\u0005ך\u0005.\u0000\"\u0000\"\u0000\u0007\u0000\u0007\u0000\n\u0000<\u0000י\u0005�\u0005ױ\u0005׀\u0005�\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005ו\u0005'\u0000:\u0000>\u0000\n\u0000\n\u0000ט\u0005ח\u0005 \u0000�\u0005י\u0005�\u0005 \u0000װ\u0005ׁ\u0005װ\u0005ט\u0005װ\u0005,\u0000 \u0000װ\u0005׀\u0005�\u0005 \u0000�\u0005י\u0005 \u0000�\u0005ח\u0005ױ\u0005�\u0005 \u0000�\u0005�\u0005ך\u0005ױ\u0005ׁ\u0005,\u0000 \u0000׀\u0005׳\u0005ט\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005�\u0005 \u0000\"\u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000�\u0005׃\u0005�\u0005ך\u0005\"\u0000:\u0000 \u0000\"\u0000�\u0005�\u0005 \u0000י\u0005�\u0005�\u0005ױ\u0005ױ\u0005ז\u0005ט\u0005 \u0000י\u0005״\u0005׳\u0005 \u0000װ\u0005ך\u0005׀\u0005ט\u0005ׂ\u0005א\u0005ױ\u0005ך\u0005 \u0000�\u0005ה\u0005ך\u0005�\u0005׳\u0005ך\u0005 \u0000װ\u0005׃\u0005�\u0005ך\u0005 \u0000ג\u0005�\u0005-\u0000�\u0005׃\u0005�\u0005 \u0000׀\u0005׃\u0005�\u0005 \u0000װ\u0005�\u0005ך\u0005א\u0005�\u0005�\u0005ג\u0005 \u0000ׁ\u0005�\u0005�\u0005ב\u0005׀\u0005 \u0000ׂ\u0005�\u0005ׂ\u0005�\u0005�\u0005�\u0005,\u0000 \u0000ױ\u0005ׁ\u0005װ\u0005ך\u0005׀\u0005�\u0005 \u0000�\u0005י\u0005ט\u0005״\u0005ױ\u0005״\u0005 \u0000י\u0005ׁ\u0005ך\u0005ױ\u0005ב\u0005ה\u0005ך\u0005 \u0000װ\u0005י\u0005�\u0005�\u0005א\u0005�\u0005ך\u0005\"\u0000?\u0000\n\u0000\n\u0000<\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000׀\u0005�\u0005�\u0005�\u0005 \u0000ׂ\u0005�\u0005�\u0005׀\u0005ױ\u0005�\u0005:\u0000>\u0000\n\u0000\n\u0000ײ\u0005װ\u0005 \u0000װ\u0005ױ\u0005�\u0005�\u0005 \u0000ׁ\u0005׃\u0005�\u0005ױ\u0005ח\u0005 \u0000�\u0005א\u0005ױ\u0005י\u0005׀\u0005 \u0000י\u0005�\u0005 \u0000�\u0005�\u0005\"\u0000׃\u0005 \u0000ׁ\u0005׃\u0005�\u0005ט\u0005װ\u0005 \u0000ה\u0005ט\u0005״\u0005�\u0005ך\u0005.\u0000 \u0000\n\u0000\n\u0000<\u0000י\u0005�\u0005ױ\u0005׀\u0005�\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005ױ\u0005ׁ\u0005�\u0005ו\u0005'\u0000:\u0000>\u0000\n\u0000\n\u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ז\u0005�\u0005ג\u0005 \u0000׀\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005׀\u0005ױ\u0005ט\u0005 \u0000�\u0005װ\u0005 \u0000י\u0005װ\u0005ׁ\u0005װ\u0005�\u0005ט\u0005ױ\u0005 \u0000ה\u0005װ\u0005,\u0000 \u0000י\u0005ׁ\u0005י\u0005ט\u0005״\u0005ױ\u0005״\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ח\u0005�\u0005ט\u0005.\u0000 \u0000װ\u0005ט\u0005�\u0005 \u0000װ\u0005ח\u0005�\u0005ט\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005ױ\u0005ה\u0005�\u0005ג\u0005 \u0000ׁ\u0005י\u0005ט\u0005״\u0005ױ\u0005״\u0005.\u0000 \u0000�\u0005א\u0005ױ\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005ט\u0005ױ\u0005ט\u0005 \u0000י\u0005ׁ\u0005י\u0005״\u0005׳\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000׀\u0005ב\u0005ױ\u0005ט\u0005 \u0000י\u0005�\u0005װ\u0005�\u0005װ\u0005 \u0000י\u0005ױ\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000י\u0005�\u0005ה\u0005ט\u0005�\u0005ג\u0005 \u0000�\u0005ׂ\u0005י\u0005ך\u0005.\u0000 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\b\u0000\u0000\u0018\b\u0000\u0000\u001a\b\u0000\u0000 \b\u0000\u0000,\b\u0000\u0000.\b\u0000\u00002\b\u0000\u00004\b\u0000\u00006\b\u0000\u0000P\b\u0000\u0000V\b\u0000\u0000X\b\u0000\u0000Z\b\u0000\u0000 \b\u0000\u0000¢\b\u0000\u0000\u0010 \u0000\u0000\u0012 \u0000\u0000\u0014 \u0000\u0000\u0018 \u0000\u0000\u001a \u0000\u0000* \u0000\u0000, \u0000\u0000. \u0000\u00000 \u0000\u00002 \u0000\u0000� \u0000\u0000קךגק׳ְֽ¬ק¢¬ְקְ˜�‚ֽl�_lֽQI\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u000f\u0015hr;\u0012\u0000\u0016hr;\u0012\u0000Z\b�\u001b\u0003j\u0000\u0000\u0000\u0000 *\u0007\u0016hr;\u0012\u0000<\b�U\b\u0001Z\b��*\u0001\u0018\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u00005\b�>*\u0001Z\b�\\\b�\u0000*\u0003j\u0000\u0000\u0000\u0000 *\u0007\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u00005\b�<\b�>*\u0001U\b\u0001Z\b�\\\b��*\u0001\u0000\u000f\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u0000Z\b�\u001b\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u00005\b�>*\u0001Z\b�\\\b�o(\u0002\u0012\u0016hr;\u0012\u00005\b�>*\u0001Z\b�\\\b�\u0000\u0012\u0016hס\u001b\u000f\u00005\b�Z\b�\\\b�o(\u0002\u0000'\u0003j\u0000\u0000\u0000\u0000 *\u0007\u0015h₪\u0013‡\u0000\u0016hֱX\u0017\u00005\b�<\b�U\b\u0001Z\b�\\\b��*\u0001\u0018\u0015h₪\u0013‡\u0000\u0016h\u0016Aז\u0000