\u0000׀\u0005�\u0005ז\u0005ג\u0005�\u0005�\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005ׁ\u0005�\u0005״\u0005׳\u0005ױ\u0005�\u0005\n\u0000ג\u0005ױ\u0005\"\u0000׃\u0005 \u0000׀\u0005�\u0005ױ\u0005�\u0005 \u0000׳\u0005׀\u0005�\u0005׃\u0005,\u0000 \u0000ט\u0005י\u0005�\u0005 \u0000װ\u0005ג\u0005�\u0005ױ\u0005ך\u0005ױ\u0005ך\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005�\u0005\n\u0000׃\u0005ט\u0005ױ\u0005ט\u0005 \u0000׀\u0005ט\u0005�\u0005,\u0000 \u0000ט\u0005י\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005׀\u0005ׂ\u0005�\u0005׃\u0005�\u0005�\u0005,\u0000 \u0000�\u0005י\u0005ט\u0005׃\u0005 \u0000װ\u0005�\u0005י\u0005ה\u0005״\u0005�\u0005�\u0005\n\u0000\n\u0000\n\u0000�\u0005�\u0005ג\u0005ױ\u0005ו\u0005 \u0000�\u0005י\u0005ה\u0005״\u0005�\u0005:\u0000 \u0000׀\u0005ך\u0005�\u0005 \u0000ׁ\u0005א\u0005׃\u0005�\u0005ט\u0005\n\u0000\n\u0000\n\u0000�\u0005א\u0005װ\u0005�\u0005ך\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005:\u0000 \u0000�\u0005׀\u0005װ\u0005 \u0000ױ\u0005ט\u0005ױ\u0005�\u0005\n\u0000\n\u0000\n\u0000ט\u0005י\u0005�\u0005ך\u0005 \u0000ה\u0005ט\u0005�\u0005�\u0005א\u0005״\u0005ט\u0005�\u0005ך\u0005:\u0000 \u0000װ\u0005׃\u0005ב\u0005 \u0000׃\u0005ױ\u0005�\u0005״\u0005י\u0005\n\u0000\n\u0000\n\u0000 \u0000\n\u0000\n\u0000 \u00001\u0000.\u0000 \u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000(\u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000�\u0005װ\u0005׳\u0005ײ\u0005ח\u0005װ\u0005 \u0000ױ\u0005�\u0005י\u0005�\u0005�\u0005ױ\u0005י\u0005 \u0000ׁ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000ײ\u0005ױ\u0005װ\u0005ט\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ב\u0005\"\u0000ײ\u0005-\u00002\u00000\u00000\u00007\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000׀\u0005ט\u0005׃\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000 \u0000ׁ\u0005ױ\u0005ח\u0005ט\u0005 \u0000״\u0005ױ\u0005ׁ\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000�\u0005ך\u0005�\u0005ׁ\u0005׃\u0005 \u0000�\u0005ה\u0005ך\u0005ױ\u0005׳\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005�\u0005י\u0005�\u0005ׁ\u0005װ\u0005.\u0000 \u0000ג\u0005�\u0005 \u0000ב\u0005׃\u0005ט\u0005 \u0000װ\u0005�\u0005ױ\u0005�\u0005 \u0000ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000(\u0000ה\u0005״\u0005ױ\u0005ט\u0005 \u0000�\u0005װ\u0005׳\u0005ײ\u0005ח\u0005װ\u0005 \u0000ױ\u0005�\u0005י\u0005�\u0005�\u0005ױ\u0005י\u0005 \u0000ׁ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000ײ\u0005ױ\u0005װ\u0005ט\u0005)\u0000,\u0000 \u0000װ\u0005ך\u0005י\u0005ב\u0005\"\u0000ײ\u0005-\u00002\u00000\u00000\u00007\u0000.\u0000\n\u0000\n\u0000 \u0000�\u0005ױ\u0005א\u0005׳\u0005ך\u0005 \u0000�\u0005ה\u0005א\u0005�\u0005א\u0005ױ\u0005 \u0000ׁ\u0005ח\u0005י\u0005ך\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005ך\u0005׳\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000ױ\u0005װ\u0005ׁ\u0005״\u0005�\u0005׳\u0005ױ\u0005ך\u0005 \u0000ׁ\u0005׃\u0005ט\u0005�\u0005�\u0005�\u0005,\u0000 \u0000י\u0005׀\u0005ױ\u0005�\u0005 \u0000�\u0005ױ\u0005ה\u0005ײ\u0005.\u0000 \u0000ג\u0005ח\u0005ט\u0005ױ\u0005א\u0005�\u0005ך\u0005,\u0000 \u0000׳\u0005ױ\u0005ח\u0005ח\u0005 \u0000׳\u0005ױ\u0005ח\u0005 \u0000י\u0005�\u0005׳\u0005�\u0005�\u0005ׁ\u0005 \u0000א\u0005װ\u0005ׂ\u0005 \u0000י\u0005א\u0005ױ\u0005װ\u0005ׂ\u0005 \u0000ׁ\u0005׃\u0005ט\u0005�\u0005 \u0000י\u0005׀\u0005�\u0005א\u0005װ\u0005 \u0000ג\u0005�\u0005ט\u0005ױ\u0005א\u0005�\u0005ך\u0005 \u0000�\u0005�\u0005ׁ\u0005ױ\u0005י\u0005 \u0000׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000ײ\u0005ױ\u0005װ\u0005ט\u0005,\u0000 \u0000�\u0005י\u0005׀\u0005׃\u0005�\u0005 \u0000�\u0005ױ\u0005ט\u0005׃\u0005 \u0000�\u0005װ\u0005ט\u0005�\u0005ׁ\u0005,\u0000 \u0000ױ\u0005�\u0005ה\u0005�\u0005 \u0000ׁ\u0005ח\u0005י\u0005ך\u0005 \u0000י\u0005ט\u0005 \u0000װ\u0005ך\u0005׳\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000׀\u0005ײ\u0005 \u0000װ\u0005ױ\u0005�\u0005א\u0005ב\u0005 \u0000ב\u0005ג\u0005�\u0005ד\u0005 \u0000י\u0005י\u0005ט\u0005 \u0000װ\u0005ך\u0005׳\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000�\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005׳\u0005ט\u0005�\u0005ׂ\u0005 \u0000ב\u0005ױ\u0005ׂ\u0005�\u0005 \u0000�\u0005�\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005 \u0000ׁ\u0005׀\u0005�\u0005י\u0005ױ\u0005ט\u0005 \u0000ױ\u0005ג\u0005׃\u0005ך\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005װ\u0005 \u0000�\u0005׳\u0005ױ\u0005ׁ\u0005װ\u0005 \u0000ײ\u0005ױ\u0005,\u0000 \u0000ױ\u0005�\u0005ג\u0005ך\u0005 \u0000�\u0005י\u0005 \u0000ׁ\u0005ח\u0005י\u0005װ\u0005 \u0000�\u0005ײ\u0005ױ\u0005.\u0000 \u0000ך\u0005ז\u0005�\u0005ׂ\u0005 \u0000׀\u0005ױ\u0005ך\u0005װ\u0005 \u0000ג\u0005ױ\u0005\"\u0000׃\u0005 \u0000׳\u0005ױ\u0005װ\u0005 \u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005א\u0005�\u0005,\u0000 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005.\u0000\n\u0000\n\u0000׳\u0005ױ\u0005װ\u0005 \u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005א\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000�\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005ט\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005׳\u0005ח\u0005�\u0005ח\u0005װ\u0005 \u0000ז\u0005װ\u0005\"\u0000�\u0005 \u0000ׁ\u0005�\u0005ח\u0005י\u0005 \u0000י\u0005�\u0005�\u0005ז\u0005׀\u0005ױ\u0005 \u0000�\u0005ז\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000װ\u0005�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ױ\u0005 \u0000ה\u0005ך\u0005ט\u0005ױ\u0005�\u0005.\u0000 \u0000ׁ\u0005װ\u0005ך\u0005׳\u0005�\u0005װ\u0005 \u0000׃\u0005ױ\u0005ׁ\u0005ט\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000ג\u0005ז\u0005�\u0005ױ\u0005 \u0000�\u0005ג\u0005י\u0005ױ\u0005ך\u0005 \u0000׳\u0005ט\u0005�\u0005ׂ\u0005 \u0000ױ\u0005ׁ\u0005ב\u0005ױ\u0005ה\u0005ױ\u0005 \u0000י\u0005�\u0005 \u0000׃\u0005ׁ\u0005ט\u0005 \u0000�\u0005װ\u0005 \u0000י\u0005א\u0005ׂ\u0005�\u0005ט\u0005 \u0000ׁ\u0005י\u0005�\u0005ׁ\u0005 \u0000װ\u0005װ\u0005�\u0005א\u0005װ\u0005 \u0000�\u0005ח\u0005ט\u0005�\u0005׀\u0005װ\u0005 \u0000י\u0005א\u0005�\u0005�\u0005װ\u0005 \u0000ױ\u0005י\u0005�\u0005�\u0005י\u0005�\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000װ\u0005ב\u0005�\u0005�\u0005ך\u0005 \u0000װ\u0005י\u0005ט\u0005 \u0000ׁ\u0005׀\u0005�\u0005י\u0005ױ\u0005ט\u0005 \u0000װ\u0005ױ\u0005ױ\u0005ג\u0005׃\u0005װ\u0005 \u0000�\u0005ך\u0005ך\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005�\u0005�\u0005.\u0000 \u0000װ\u0005�\u0005ױ\u0005 \u0000ב\u0005ױ\u0005ׂ\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005 \u0000א\u0005ױ\u0005ב\u0005ה\u0005�\u0005�\u0005 \u0000י\u0005װ\u0005�\u0005ױ\u0005 \u0000ׁ\u0005׃\u0005ג\u0005ך\u0005א\u0005ױ\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000י\u0005�\u0005ׁ\u0005,\u0000 \u0000�\u0005�\u0005ג\u0005״\u0005 \u0000ז\u0005װ\u0005\"\u0000�\u0005 \u0000י\u0005ױ\u0005�\u0005 \u0000ׂ\u0005ױ\u0005ט\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ה\u0005א\u0005װ\u0005 \u0000ׁ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005 \u0000�\u0005ח\u0005ׁ\u0005�\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005.\u0000 \u0000\n\u0000\n\u0000�\u0005װ\u0005ײ\u0005�\u0005�\u0005ט\u0005,\u0000 \u0000�\u0005�\u0005י\u0005�\u0005ך\u0005 \u0000�\u0005י\u0005ט\u0005׀\u0005�\u0005 \u0000ך\u0005�\u0005�\u0005װ\u0005 \u0000ׁ\u0005׳\u0005ױ\u0005ח\u0005 \u0000ױ\u0005�\u0005י\u0005 \u0000ה\u0005װ\u0005 \u0000ה\u0005ױ\u0005״\u0005א\u0005ז\u0005�\u0005׀\u0005�\u0005 \u0000�\u0005װ\u0005ז\u0005�\u0005ך\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005,\u0000 \u0000�\u0005׃\u0005ג\u0005ך\u0005א\u0005ױ\u0005.\u0000 \u0000ײ\u0005ױ\u0005 \u0000װ\u0005ב\u0005�\u0005ׁ\u0005װ\u0005 \u0000י\u0005ך\u0005�\u0005�\u0005א\u0005ױ\u0005 \u0000ׁ\u0005ױ\u0005.\u0000 \u0000ׁ\u0005ט\u0005�\u0005ך\u0005 \u0000ז\u0005�\u0005ױ\u0005ך\u0005 \u0000׀\u0005א\u0005ױ\u0005 \u0000ט\u0005ױ\u0005׀\u0005�\u0005�\u0005 \u0000י\u0005װ\u0005ז\u0005�\u0005ׁ\u0005ױ\u0005ט\u0005 \u0000�\u0005׳\u0005ײ\u0005�\u0005ח\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005�\u0005�\u0005,\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000ח\u0005ז\u0005ך\u0005 \u0000�\u0005ױ\u0005ך\u0005ט\u0005 \u0000ב\u0005ה\u0005ח\u0005א\u0005�\u0005ך\u0005 \u0000�\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000װ\u0005�\u0005ױ\u0005ׁ\u0005י\u0005�\u0005�\u0005.\u0000\n\u0000\n\u0000 \u0000װ\u0005ׁ\u0005ח\u0005י\u0005װ\u0005 \u0000י\u0005�\u0005 \u0000ז\u0005װ\u0005\"\u0000�\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005ך\u0005,\u0000 \u0000�\u0005ז\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005ױ\u0005׃\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005�\u0005�\u0005.\u0000 \u0000ׁ\u0005ט\u0005י\u0005ױ\u0005ך\u0005�\u0005 \u0000׀\u0005ח\u0005ט\u0005׀\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005ױ\u0005ז\u0005ג\u0005ױ\u0005ך\u0005.\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000׀\u0005ט\u0005׃\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000 \u0000׀\u0005ׂ\u0005ׁ\u0005,\u0000 \u0000װ\u0005�\u0005׀\u0005 \u0000�\u0005׀\u0005 \u0000�\u0005�\u0005 \u0000�\u0005�\u0005 \u0000�\u0005ז\u0005ױ\u0005�\u0005ז\u0005�\u0005ך\u0005,\u0000 \u0000�\u0005�\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005ט\u0005׀\u0005ך\u0005 \u0000ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000ײ\u0005װ\u0005 \u0000�\u0005װ\u0005 \u0000י\u0005ז\u0005װ\u0005\"\u0000�\u0005 \u0000ג\u0005ױ\u0005י\u0005װ\u0005 \u0000ׁ\u0005׳\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005�\u0005�\u0005�\u0005 \u0000\u0013 \u0000װ\u0005ױ\u0005׀\u0005 \u0000ג\u0005ױ\u0005י\u0005װ\u0005 \u0000ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000�\u0005ך\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005ח\u0005ט\u0005׀\u0005ך\u0005 \u0000�\u0005ײ\u0005ױ\u0005.\u0000\n\u0000\n\u0000׳\u0005ױ\u0005װ\u0005 \u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005א\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000׀\u0005א\u0005�\u0005 \u0000׳\u0005ױ\u0005י\u0005ׁ\u0005ך\u0005 \u0000י\u0005�\u0005י\u0005 \u0000׀\u0005�\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005�\u0005�\u0005�\u0005 \u0000ט\u0005�\u0005ׁ\u0005 \u0000ׁ\u0005ז\u0005ׁ\u0005׀\u0005 \u0000י\u0005א\u0005ג\u0005�\u0005�\u0005 \u0000ׁ\u0005׃\u0005ט\u0005�\u0005�\u0005�\u0005 \u0000ױ\u0005א\u0005�\u0005ז\u0005׀\u0005�\u0005�\u0005 \u0000ׁ\u0005ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005�\u0005א\u0005װ\u0005�\u0005ך\u0005�\u0005ך\u0005 \u0000װ\u0005�\u0005ט\u0005׳\u0005�\u0005ך\u0005 \u0000ױ\u0005ט\u0005ז\u0005ױ\u0005�\u0005װ\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000�\u0005׀\u0005ױ\u0005 \u0000׃\u0005ױ\u0005ױ\u0005ח\u0005׀\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005.\u0000 \u0000\n\u0000\n\u0000 \u0000ח\u0005ױ\u0005ט\u0005׀\u0005ך\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00001\u0000.\u0000 \u0000\n\u0000\n\u0000�\u0005׀\u0005�\u0005 \u0000׀\u0005א\u0005ױ\u0005 \u0000�\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000ט\u0005ח\u0005 \u0000ג\u0005�\u0005 \u0000א\u0005ױ\u0005י\u0005׀\u0005 \u0000װ\u0005׳\u0005ײ\u0005ח\u0005װ\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000ג\u0005�\u0005 \u0000װ\u0005י\u0005�\u0005�\u0005ױ\u0005י\u0005,\u0000 \u0000ױ\u0005׀\u0005ױ\u0005�\u0005ט\u0005�\u0005�\u0005:\u0000 \u0000ט\u0005�\u0005ׁ\u0005 \u0000י\u0005�\u0005ז\u0005ױ\u0005�\u0005 \u0000ׁ\u0005�\u0005׳\u0005ב\u0005א\u0005�\u0005 \u0000׳\u0005�\u0005ט\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005׀\u0005׳\u0005ב\u0005�\u0005 \u0000ׁ\u0005ױ\u0005 \u0000ׂ\u0005�\u0005 \u0000׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000ײ\u0005ױ\u0005װ\u0005ט\u0005.\u0000\n\u0000\n\u0000װ\u0005�\u0005ױ\u0005\"\u0000ט\u0005 \u0000ׂ\u0005�\u0005ג\u0005׃\u0005 \u0000׀\u0005ט\u0005׃\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000 \u0000�\u0005�\u0005װ\u0005 \u0000�\u0005׀\u0005?\u0000\n\u0000\n\u0000�\u0005י\u0005װ\u0005 \u0000׀\u0005ׁ\u0005�\u0005ׁ\u0005:\u0000\n\u0000\n\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000א\u0005�\u0005ז\u0005׀\u0005 \u0000ׁ\u0005�\u0005׳\u0005ב\u0005�\u0005,\u0000 \u0000׀\u0005ײ\u0005 \u0000׀\u0005�\u0005�\u0005 \u0000ב\u0005�\u0005ׁ\u0005װ\u0005 \u0000י\u0005�\u0005װ\u0005�\u0005װ\u0005 \u0000ג\u0005�\u0005�\u0005ױ\u0005 \u0000׀\u0005ה\u0005ױ\u0005׃\u0005.\u0000 \u0000ׁ\u0005ט\u0005ׂ\u0005ג\u0005 \u0000י\u0005װ\u0005ױ\u0005׀\u0005 \u0000�\u0005ױ\u0005ז\u0005׀\u0005,\u0000 \u0000װ\u0005ױ\u0005׀\u0005 \u0000�\u0005ח\u0005ׁ\u0005�\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005.\u0000 \u0000\n\u0000\n\u0000׳\u0005ױ\u0005װ\u0005 \u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005א\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000װ\u0005י\u0005א\u0005�\u0005 \u0000װ\u0005ױ\u0005׀\u0005 \u0000ט\u0005�\u0005ׁ\u0005 \u0000י\u0005�\u0005׀\u0005 \u0000ט\u0005י\u0005׀\u0005�\u0005 \u0000׀\u0005�\u0005׀\u0005 \u0000ׁ\u0005ך\u0005׳\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005׳\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ז\u0005ׁ\u0005׀\u0005,\u0000 \u0000�\u0005׀\u0005׳\u0005ט\u0005 \u0000י\u0005׳\u0005ױ\u0005ׁ\u0005ך\u0005 \u0000װ\u0005�\u0005ׁ\u0005�\u0005י\u0005װ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000ט\u0005ח\u0005 \u0000ׁ\u0005׃\u0005ט\u0005�\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005ט\u0005ױ\u0005א\u0005�\u0005ך\u0005,\u0000 \u0000ט\u0005�\u0005ׁ\u0005 \u0000י\u0005׀\u0005�\u0005א\u0005ױ\u0005 \u0000ט\u0005י\u0005׀\u0005�\u0005 \u0000�\u0005ה\u0005�\u0005 \u0000ה\u0005ח\u0005ױ\u0005׃\u0005ױ\u0005ך\u0005 \u0000װ\u0005ז\u0005ׁ\u0005׀\u0005 \u0000�\u0005א\u0005ױ\u0005ג\u0005 \u0000ׁ\u0005׃\u0005ט\u0005�\u0005 \u0000ׁ\u0005�\u0005�\u0005 \u0000ג\u0005�\u0005ט\u0005ױ\u0005א\u0005�\u0005ך\u0005 \u0000�\u0005װ\u0005�\u0005װ\u0005 \u0000�\u0005ױ\u0005ׂ\u0005ׁ\u0005�\u0005 \u0000ׁ\u0005ך\u0005׳\u0005ױ\u0005�\u0005�\u0005 \u0000�\u0005׳\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ז\u0005ׁ\u0005׀\u0005,\u0000 \u0000ׂ\u0005�\u0005 \u0000�\u0005׀\u0005 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000י\u0005�\u0005ױ\u0005׳\u0005ײ\u0005ח\u0005 \u0000ׁ\u0005ױ\u0005 \u0000׀\u0005ה\u0005ױ\u0005׃\u0005.\u0000\n\u0000\n\u0000 \u0000ח\u0005ױ\u0005ט\u0005׀\u0005ך\u0005 \u0000ך\u0005ח\u0005א\u0005װ\u0005 \u00002\u0000.\u0000 \u0000\n\u0000\n\u0000 \u0000׀\u0005א\u0005ױ\u0005 \u0000�\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005׀\u0005�\u0005 \u0000ג\u0005�\u0005 \u0000י\u0005א\u0005�\u0005 \u0000ך\u0005א\u0005׀\u0005�\u0005�\u0005 \u0000�\u0005ז\u0005״\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000\u0013 \u0000׀\u0005�\u0005\"\u0000ד\u0005,\u0000 \u0000װ\u0005א\u0005װ\u0005�\u0005ׂ\u0005װ\u0005 \u0000װ\u0005�\u0005׀\u0005 \u0000ׁ\u0005�\u0005ב\u0005ׂ\u0005ט\u0005ך\u0005 \u0000ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000�\u0005ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005,\u0000 \u0000ױ\u0005י\u0005א\u0005�\u0005ך\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000װ\u0005�\u0005ׁ\u0005�\u0005י\u0005װ\u0005 \u0000�\u0005ה\u0005ט\u0005�\u0005ג\u0005װ\u0005 \u0000�\u0005׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000ך\u0005ה\u0005ח\u0005�\u0005׃\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005.\u0000 \u0000װ\u0005ה\u0005״\u0005ױ\u0005ט\u0005 \u0000�\u0005ױ\u0005ך\u0005א\u0005װ\u0005 \u0000ׁ\u0005ח\u0005�\u0005ױ\u0005�\u0005װ\u0005 \u0000ׂ\u0005�\u0005 \u0000י\u0005�\u0005 \u0000װ\u0005ה\u0005ט\u0005ג\u0005װ\u0005.\u0000\n\u0000\n\u0000׀\u0005ך\u0005�\u0005 \u0000ׁ\u0005א\u0005׃\u0005�\u0005ט\u0005:\u0000\n\u0000\n\u0000 \u0000 \u0000�\u0005�\u0005 \u0000ח\u0005ױ\u0005ׁ\u0005ג\u0005 \u0000׀\u0005�\u0005 \u0000װ\u0005�\u0005װ\u0005 \u0000ׁ\u0005�\u0005ׁ\u0005�\u0005י\u0005ך\u0005 \u0000װ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000�\u0005׃\u0005�\u0005 \u0000�\u0005װ\u0005ה\u0005ט\u0005�\u0005ג\u0005?\u0000 \u0000װ\u0005ט\u0005�\u0005 \u0000�\u0005׃\u0005ױ\u0005ׁ\u0005ט\u0005 \u0000ג\u0005�\u0005 \u0000ך\u0005א\u0005׀\u0005�\u0005 \u0000�\u0005ׁ\u0005�\u0005�\u0005ױ\u0005�\u0005 \u0000׀\u0005ױ\u0005ׁ\u0005�\u0005�\u0005ח\u0005״\u0005�\u0005ׁ\u0005�\u0005,\u0000 \u0000׀\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005 \u0000װ\u0005׃\u0005ׁ\u0005ט\u0005�\u0005�\u0005 \u0000װ\u0005׀\u0005�\u0005װ\u0005 \u0000ׁ\u0005ט\u0005ױ\u0005ט\u0005�\u0005�\u0005?\u0000 \u0000�\u0005�\u0005 \u0000�\u0005�\u0005ױ\u0005�\u0005 \u0000װ\u0005ח\u0005ז\u0005�\u0005�\u0005 \u0000׀\u0005ױ\u0005 \u0000װ\u0005׳\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005ג\u0005ך\u0005 \u0000װ\u0005ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000װ\u0005�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000�\u0005ױ\u0005�\u0005ט\u0005 \u0000י\u0005ײ\u0005װ\u0005 \u0000װ\u0005ה\u0005ט\u0005�\u0005ג\u0005 \u0000�\u0005ױ\u0005.\u0000 \u0000\n\u0000\n\u0000׳\u0005ױ\u0005װ\u0005 \u0000ט\u0005׀\u0005ױ\u0005ׁ\u0005א\u0005�\u0005:\u0000\n\u0000\n\u0000 \u0000װ\u0005ך\u0005א\u0005׀\u0005�\u0005 \u0000װ\u0005ײ\u0005װ\u0005 \u0000ׁ\u0005׀\u0005 \u0000�\u0005ױ\u0005�\u0005ט\u0005 \u0000י\u0005ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005 \u0000׀\u0005�\u0005א\u0005�\u0005 \u0000ה\u0005״\u0005ױ\u0005ט\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005י\u0005ט\u0005 \u0000װ\u0005�\u0005 \u0000ה\u0005ג\u0005�\u0005�\u0005ױ\u0005ך\u0005 \u0000�\u0005ׁ\u0005ז\u0005ג\u0005�\u0005ך\u0005 \u0000׀\u0005ױ\u0005 \u0000׀\u0005�\u0005�\u0005ױ\u0005א\u0005�\u0005�\u0005,\u0000 \u0000ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005 \u0000ך\u0005א\u0005׀\u0005�\u0005 \u0000א\u0005ױ\u0005ב\u0005ד\u0005,\u0000 \u0000י\u0005ז\u0005ט\u0005�\u0005�\u0005 \u0000�\u0005�\u0005י\u0005�\u0005 \u0000׀\u0005�\u0005ײ\u0005װ\u0005 \u0000׳\u0005�\u0005ב\u0005�\u0005ױ\u0005�\u0005 \u0000ױ\u0005ב\u0005ױ\u0005׃\u0005�\u0005ױ\u0005ך\u0005 \u0000ג\u0005�\u0005 \u0000ג\u0005ז\u0005�\u0005 \u0000װ\u0005�\u0005�\u0005ז\u0005׀\u0005ױ\u0005ך\u0005 \u0000׳\u0005�\u0005�\u0005�\u0005�\u0005�\u0005 \u0000ׁ\u0005׀\u0005ױ\u0005ך\u0005ױ\u0005 \u0000�\u0005ח\u0005ױ\u0005�\u0005,\u0000 \u0000�\u0005י\u0005װ\u0005׀\u0005ה\u0005ױ\u0005׃\u0005 \u0000װ\u0005ײ\u0005ױ\u0005װ\u0005ט\u0005,\u0000 \u0000ך\u0005ה\u0005ח\u0005�\u0005׃\u0005ױ\u0005 \u0000�\u0005װ\u0005ׁ\u0005�\u0005�\u0005״\u0005 \u0000׀\u0005ך\u0005 \u0000װ\u0005א\u0005ױ\u0005�\u0005׳\u0005ױ\u0005ך\u0005 \u0000י\u0005�\u0005װ\u0005�\u0005.\u0000 \u0000�\u0005י\u0005 \u0000�\u0005א\u0005ױ\u0005 \u0000ׁ\u0005ך\u0005ח\u0005א\u0005ױ\u0005ך\u0005 \u0000װ\u0005ך\u0005ג\u0005ׁ\u0005ױ\u0005ט\u0005װ\u0005 \u0000ג\u0005ױ\u0005׃\u0005 \u0000�\u0005ח\u0005ױ\u0005�\u0005ױ\u0005ך\u0005 \u0000י\u0005ׁ\u0005װ\u0005�\u0005 \u0000׀\u0005א\u0005ױ\u0005 \u0000א\u0005ױ\u0005ך\u0005א\u0005�\u0005�\u0005 \u0000\u0000\u0000\u0000\u0000\u0000\u0006\u0000\u0000 \b\u0000\u0000 \b\u0000\u0000H\b\u0000\u0000R\b\u0000\u0000Z\b\u0000\u0000v\b\u0000\u0000¦\b\u0000\u0000מ\b\u0000\u0000נ\b\u0000\u0000 \u0000\u0000\u000e \u0000\u0000& \u0000\u0000* \u0000\u0000, \u0000\u0000< \u0000\u0000> \u0000\u0000ִ \u0000\u0000ֶ \u0000\u0000־ \u0000\u0000׀ \u0000\u0000ׂ \u0000\u0000װ \u0000\u0000ך \u0000\u0000מ \u0000\u0000\u0002\n\u0000\u0000\u0004\n\u0000\u0000\u0012\n\u0000\u0000\u0014\n\u0000\u0000\"\n\u0000\u0000$\n\u0000\u0000: \u0000\u0000< \u0000\u0000\" \u0000\u0000$ \u0000\u00008 \u0000\u0000: \u0000\u0000T \u0000\u0000l \u0000\u0000n \u0000\u0000p \u0000\u0000† \u0000\u0000¢ \u0000\u0000₪ \u0000\u0000÷ \u0000\u0000¼ \u0000\u0000¾ \u0000\u0000ֲ \u0000\u0000ִ \u0000\u0000ֶ \u0000\u0000D\n\u0000\u0000F\n\u0000\u0000פחפ�ֻ�ֻ»¬»¬»�»¬¢ֻ¢¬¢¬¢¬¢–¢–¢¬¢–¢–¬»¬–¬¢ֻ–»¢–ֻ�„–¢»ֻ\u0000\u0000\u0000\u0000\u0000\u000f\u0015h\u0004S­\u0000\u0016h\u0004S­\u0000Z\b�\u0012\u0015h\u0004S­\u0000\u0016h\u0004S­\u0000Z\b�o(\u0002\u0000\u0016\u0015h\u0004S­\u0000\u0016h\u0004S­\u0000Z\b�^J\u0003\u0000o(\u0002\u0000\u0013\u0015h\u0004S­\u0000\u0016h\u0004S­\u0000Z\b�^J\u0003\u0000 \u0015h\u0004S­\u0000\u0016h\u0004S­\u00005\b�>*\u0001Z\b�\\\b�^J\u0003\u0000\u0000 \u0015h\u0004S­\u0000\u0016h\u0004S­\u00005\b�>*\u0001Z\b�\\\b�^J\u0003\u0000o(\u0002 \u0015h\u0004S­\u0000\u0016h\u0004S­\u00005\b�Z\b�\\\b�^J\u0003\u0000o(\u0002\u0000\u0019